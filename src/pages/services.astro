---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icons.astro';
import { SITE, ADDONS, CTA } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../data/schema';

const path = '/services/';
const title = 'Mobile Detailing Services & Prices | Oakland, CA | J&W';
const description =
  'Every J&W mobile detailing service explained — interior, exterior, paint correction, ceramic coating, odor removal and RV. Quoted per vehicle, done at your home.';

const faqs = [
  { q: 'How do you decide what my car needs?', a: 'We look at the vehicle rather than sell you a package. Tell us what you drive, how it is stored and what is bothering you — swirls, stains, pet hair, odor — and Jalil recommends the shortest route to the result you want, then quotes it exactly. If a cheaper service gets you there, that is the one we book.' },
  { q: 'What is included in a full detail?', a: 'A full detail combines our exterior detail (two-bucket hand wash, clay bar and iron decontamination, wheels and tires, wax or sealant) with an interior detail (full vacuum and air blowout, steam, shampoo extraction, glass, leather conditioning). It takes 3–7 hours and runs for a standard sedan up to for premium tiers on large or heavily soiled vehicles.' },
  { q: 'How do I know which service I need?', a: 'Rough paint that feels gritty after a wash = exterior Clay & Seal. Visible swirls or scratches = paint correction. Stains, smells or pet hair = interior Deep Shampoo or Diamond Reset. New car or you want to stop waxing = ceramic coating. Not sure? Send photos and we will tell you honestly.' },
  { q: 'Do you offer packages or discounts?', a: 'Bundling interior + exterior into a full detail is always cheaper than separate bookings, and repeat customers on a maintenance schedule (every 2–3 months) get priority booking and maintenance pricing. Ask when you book.' },
  { q: 'How do I pay?', a: 'Cash, credit/debit card, Zelle or Venmo — after the walk-around, once you are happy. No deposit is required to book.' },
];

const schema = [faqSchema(faqs), breadcrumbSchema([{ label: 'Services', href: path }])];
---

<Base {title} {description} canonical={path} {schema} ogImage="/images/og-default.jpg">
  <PageHero
    crumbs={[{ label: 'Services' }]}
    eyebrow="Services & pricing"
    titleHtml="Every mobile detailing service we offer in Oakland — <em>with real prices</em>"
    text="Interior, exterior, full detail, paint correction, ceramic coating, odor removal, RV. These are actual 2026 East Bay ranges, not “call for pricing.” Your exact quote depends on vehicle size and condition — and you'll have it before we book."
    image="/images/jalil-owner-jw-mobile-detailing-oakland.jpg"
    imageAlt="Jalil Wren detailing a steering wheel during a mobile detail in Oakland"
  />

  <ServicesGrid heading="Pick a service — or bundle them into a full detail" eyebrow="Core services" lead="Every service is done at your home or office across Oakland and the East Bay with our own water and power." />

  <section class="section section--soft" id="pricing">
    <div class="container">
      <div class="center" style="margin-bottom:2rem">
        <span class="eyebrow">What each service covers</span>
        <h2>What each service actually includes</h2>
        <p class="lead">Shop-quality work without the drop-off, the ride and the wait. Every vehicle is quoted individually once we know what you drive and what it needs.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Service</th><th>What's included</th><th>Time</th></tr></thead>
          <tbody>
            <tr><td><a href="/exterior-auto-detailing-oakland-california/"><strong>Exterior — Classic wash & wax</strong></a></td><td>Two-bucket hand wash, wheels & tires, glass, wax, tire dressing</td><td>~1.5 hrs</td></tr>
            <tr><td><a href="/exterior-auto-detailing-oakland-california/"><strong>Exterior — Clay & Seal</strong></a></td><td>Classic + full clay bar, iron removal, trim, paint sealant</td><td>2–3 hrs</td></tr>
            <tr><td><a href="/interior-auto-detailing-oakland-california/"><strong>Interior — Classic / Deep Shampoo / Diamond Reset</strong></a></td><td>Vacuum & blowout, steam, shampoo extraction, stain & odor, leather conditioning</td><td>2–4 hrs</td></tr>
            <tr><td><strong>Full detail — standard (sedan)</strong></td><td>Interior + exterior Classic tiers</td><td>3–4 hrs</td></tr>
            <tr><td><strong>Full detail — premium</strong></td><td>Clay & Seal + Deep Shampoo/Diamond; large or heavily soiled vehicles</td><td>4–7 hrs</td></tr>
            <tr><td><a href="/paint-correction/"><strong>Paint correction</strong></a></td><td>One-step or two-step machine polishing + decon + sealant</td><td>3–10 hrs</td></tr>
            <tr><td><a href="/ceramic-coating/"><strong>Ceramic coating — complete</strong></a></td><td>Decon + paint correction + ~3-year coating, sized to the vehicle</td><td>Full day</td></tr>
            <tr><td><a href="/odor-removal-oakland/"><strong>Ozone odor removal</strong></a></td><td>With an interior detail; smoke, pet, mildew, food</td><td>+1 hr</td></tr>
            <tr><td><a href="/rv-wash-and-rv-detailing-oakland-california/"><strong>RV wash & detail</strong></a></td><td>By length, surface & condition — free exact quote</td><td>Varies</td></tr>
          </tbody>
        </table>
      </div>
      <div class="center" style="margin-top:1.5rem">
        <a href={CTA.href} class="btn btn--primary btn--lg" data-scroll-book><Icon name="calendar" /> {CTA.label}</a>
        <p class="fud" style="justify-content:center"><Icon name="check" /> Exact quote before booking · No deposit · Pay after the walk-around</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center" style="margin-bottom:2rem">
        <span class="eyebrow">Add-ons</span>
        <h2>Finish the job properly</h2>
      </div>
      <div class="grid grid--3">
        {ADDONS.map((a) => (
          <div class="card"><div class="card__body"><h3>{a.name}</h3><p>{a.desc}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <Reviews limit={3} />
  <Faq faqs={faqs} heading="Choosing a service — common questions" />

  <section class="section section--soft" id="quote">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Not sure what you need?</span>
        <h2>Send us a couple of photos. We'll tell you straight.</h2>
        <p class="lead">Whether a Classic covers it or the car needs the deeper tier — free quote, no pressure, and we come to you.</p>
        <a href={CTA.href} class="btn btn--primary btn--lg" data-scroll-book><Icon name="calendar" /> {CTA.label}</a>
      </div>
      <QuoteForm />
    </div>
  </section>

  <CtaBand />
</Base>
