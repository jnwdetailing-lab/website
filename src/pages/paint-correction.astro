---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Icon from '../components/Icons.astro';
import { SITE, CTA } from '../data/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../data/schema';

const path = '/paint-correction/';
const title = 'Paint Correction Oakland, CA | Swirl & Scratch Removal | J&W';
const description =
  'Mobile paint correction in Oakland: machine polishing removes swirls, scratches & oxidation. One-step $250+, two-step to $800+. In your driveway. 4.9★ Google.';

const faqs = [
  { q: 'How much does paint correction cost in Oakland?', a: 'Paint correction in Oakland costs $250–$800+ with J&W Mobile Detailing. A one-step correction (removes light swirls and restores most gloss) starts at the low end for a sedan; a two-step correction for heavily swirled, scratched or oxidized paint runs toward $800+ depending on size and condition. Added to a ceramic coating, multi-step correction is +$300–$500.' },
  { q: 'What is the difference between one-step and two-step paint correction?', a: 'One-step uses a single polish and pad to remove light swirls and restore 70–85% of gloss — right for most daily drivers. Two-step starts with a heavier cutting compound to remove deeper scratches, oxidation and holograms, then refines with a finishing polish for maximum clarity — for neglected, black or show-level paint.' },
  { q: 'Will paint correction remove all scratches?', a: 'It removes scratches that are in the clear coat — swirls, wash marring, light key marks, oxidation, water-spot etching, buffer holograms. If your fingernail catches in a scratch it is through the clear coat and needs touch-up paint or body work; we will tell you before we start.' },
  { q: 'How long does paint correction take?', a: 'One-step correction takes 3–5 hours; two-step takes 6–10 hours and can be a two-visit job on large vehicles. Add 2–4 hours when combined with a ceramic coating.' },
  { q: 'Is paint correction safe for my clear coat?', a: 'Yes when done right. We inspect under light, measure and work with the least aggressive combination that gets the result, using a dual-action polisher, proper pads and compounds. Correction removes microns of clear — it is safe a few times over a car\'s life, which is exactly why you should protect it afterward.' },
  { q: 'Should I ceramic coat after paint correction?', a: 'Yes — correction gives you the flawless surface; a coating keeps it that way for ~3 years and stops new swirls from forming as easily. Our ceramic coating packages include one-step (Silver) or two-step (Gold) correction for this reason.' },
  { q: 'Can you do paint correction at my house?', a: 'Yes. We bring power, lighting, water and shade solutions. A driveway, garage or covered spot is ideal because we need to work out of direct sun; we will talk through your parking when you book.' },
];

const schema = [
  serviceSchema({
    name: 'Paint Correction',
    description: 'Mobile paint correction in Oakland and the East Bay: machine polishing that removes swirl marks, scratches, oxidation and holograms. One-step and two-step correction, finished with sealant or ceramic coating.',
    path,
    image: '/images/paint-correction-polishing-oakland.jpg',
    offers: [
      { name: 'One-Step Paint Correction', description: 'Single-stage polish removing light swirls and restoring most gloss. Includes wash, clay & iron decontamination, sealant.' },
      { name: 'Two-Step Paint Correction', description: 'Compound + polish for heavily swirled, scratched or oxidized paint. Includes wash, clay & iron decontamination, sealant.' },
    ],
  }),
  faqSchema(faqs),
  breadcrumbSchema([{ label: 'Services', href: '/services/' }, { label: 'Paint Correction', href: path }]),
];

const steps = [
  { title: 'Inspect & prep', text: 'We inspect the paint under LED light, note defects and problem panels, then wash, iron-remove and clay every surface so nothing gets ground into the paint during polishing.' },
  { title: 'Correct', text: 'Dual-action polisher, the right cutting or polishing pad and compound for your paint. Swirls, scratches, oxidation, holograms and water-spot etching are polished out panel by panel.' },
  { title: 'Refine & clean', text: 'Two-step jobs get a finishing polish for maximum clarity. Every panel is wiped with a panel prep solution to remove oils and residue and reveal the true result.' },
  { title: 'Protect', text: 'Corrected paint is naked paint. We finish with a synthetic sealant — or, ideally, a ceramic coating — so the finish you paid for lasts.' },
];
---

<Base {title} {description} canonical={path} {schema} ogImage="/images/paint-correction-polishing-oakland.jpg" preloadImage="/images/paint-correction-polishing-oakland.jpg">
  <PageHero
    crumbs={[{ label: 'Services', href: '/services/' }, { label: 'Paint Correction' }]}
    eyebrow="Mobile paint correction · Oakland & East Bay"
    titleHtml="Paint Correction in Oakland — <em>swirls, scratches & haze polished out</em>, in your driveway"
    text="Machine polishing that restores the deep, wet, reflective finish your paint had on day one. One-step for daily drivers, two-step for neglected or black paint. The right prep before any ceramic coating."
    note="One-step → two-step · 3–10 hours"
    image="/images/paint-correction-polishing-oakland.jpg"
    imageAlt="Dual-action polisher removing swirl marks from a hood during mobile paint correction in Oakland, CA"
    bullets={['Removes swirls, light scratches, oxidation, holograms, water spots', 'Least-aggressive method that gets the result — clear coat preserved', 'Finished with sealant or ceramic coating']}
  />

  <section class="section">
    <div class="container two-col">
      <div class="prose">
        <span class="eyebrow">What it is</span>
        <h2 class="mt-0">Polishing, not filling: the defects are actually gone</h2>
        <p><strong>Paint correction in Oakland with J&W costs $250–$800+ and takes 3–10 hours.</strong> Using a dual-action polisher with varying compounds, polishes and pads, we level the clear coat by microns to remove swirl marks, wash marring, light scratches, oxidation, buffer holograms and water-spot etching — then protect it. Done at your home in Oakland, Piedmont, Alameda, Berkeley, Orinda or Walnut Creek.</p>
        <p>Most "swirl removers" and glazes fill defects with oils that wash out in two weeks. Correction removes them. Under the sun on a black car at Lake Merritt you'll see the difference immediately: the spiderweb halo around reflections is gone and the paint looks wet.</p>
        <p>Look at the photo on the right — that halo under the light is what years of tunnel washes do. That's what we take out.</p>
      </div>
      <div class="img-frame"><img src="/images/paint-correction-oakland.jpg" alt="Swirl marks and scratches visible under inspection light before paint correction in Oakland" width="1080" height="1080" loading="lazy" decoding="async" /></div>
    </div>
  </section>

  <section class="section section--soft" id="packages">
    <div class="container">
      <div class="center" style="margin-bottom:2.5rem">
        <span class="eyebrow">Correction levels</span>
        <h2>One-step or two-step — we'll tell you which your paint needs</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Level</th><th>Best for</th><th>Removes</th><th>Time</th><th>Oakland price</th></tr></thead>
          <tbody>
            <tr><td><strong>One-Step Correction</strong></td><td>Daily drivers with light swirls from washes; prep for ceramic coating (Silver package)</td><td>Light swirls, wash marring, light oxidation · restores ~70–85% of gloss</td><td>3–5 hrs</td><td class="price">from $250</td></tr>
            <tr><td><strong>Two-Step Correction</strong></td><td>Heavily swirled, scratched or oxidized paint; black & dark colors; pre-sale or show cars; Gold ceramic package</td><td>Deeper scratches, holograms, heavy oxidation, water-spot etching · 85–95%+ of defects</td><td>6–10 hrs</td><td class="price">up to $800+</td></tr>
            <tr><td><strong>With ceramic coating</strong></td><td>Anyone coating their car — correction is the prep</td><td>One-step included in every complete coating; multi-step add-on</td><td>—</td><td class="price">+ $300 – $500</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top:1rem;color:var(--muted);font-size:0.95rem">Every correction includes: detailed hand wash · clay bar on all surfaces · iron contamination removal · tires and rims cleaned & dressed · removal of compound residue · sealant or wax protection. Prices vary by vehicle size and paint condition — exact quote after we see photos or the car.</p>
      <div class="center" style="margin-top:1.5rem">
        <a href={CTA.href} class="btn btn--primary btn--lg" data-scroll-book><Icon name="calendar" /> {CTA.label}</a>
        <p class="fud" style="justify-content:center"><Icon name="check" /> Free paint assessment · No deposit · We come to you</p>
      </div>
    </div>
  </section>

  <Process steps={steps} heading="How we correct paint without risking it" eyebrow="Our process" />

  <section class="section">
    <div class="container prose max-prose" style="margin-inline:auto">
      <span class="eyebrow">Why J&W</span>
      <h2 class="mt-0">Experience on real East Bay paint — and honesty about what correction can and can't do</h2>
      <p>Jalil has corrected everything from daily-driver Civics to Teslas, Rivians and black German sedans across Oakland and the East Bay. The rule is the same on every one: least aggressive combination first, measured and checked under light, never chasing a rock chip or a through-the-clear scratch with a polisher. If your fingernail catches in a scratch, it needs touch-up or body work and we'll say so before we start.</p>
      <p>Correction also only makes sense if you protect it. Corrected paint is unprotected paint — which is why most customers pair it with a <a href="/ceramic-coating/">ceramic coating</a> (correction is built into our Silver and Gold packages) or at minimum a sealant from our <a href="/exterior-auto-detailing-oakland-california/">Clay & Seal exterior detail</a>.</p>
    </div>
  </section>

  <Reviews limit={3} filterService="Paint Correction" heading="Before-and-after reactions from Oakland drivers" />
  <Faq faqs={faqs} heading="Paint correction questions, answered" />

  <section class="section section--soft" id="quote">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Get a quote</span>
        <h2>Send two photos of your paint in the sun. We'll tell you one-step or two.</h2>
        <p class="lead">Year, make, color and a couple of photos showing the swirls or scratches — that's enough for an honest assessment and a real price.</p>
        <p class="alt-book"><a href={SITE.booking} target="_blank" rel="noopener">{CTA.bookLabel} &rarr;</a></p>
      </div>
      <QuoteForm heading="Paint correction quote" />
    </div>
  </section>

  <ServicesGrid exclude={path} heading="Other services we bring to your driveway" eyebrow="More from J&W" lead="" />
  <CtaBand title="See your reflection in the paint again." />
</Base>
