---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteSection from '../components/QuoteSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ServiceVideo from '../components/ServiceVideo.astro';
import { addonPrice, usd } from '../data/pricing';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../data/schema';

const path = '/paint-correction/';
// The "Polish" add-on in Fieldd: a one-step polish on a Full Detail or exterior detail.
const polish = { price: addonPrice('Polish') };
const title = 'Paint Correction Oakland, CA | Swirl & Scratch Removal | J&W';
const description = `Mobile paint correction in Oakland: machine polishing removes swirl marks, light scratches, oxidation and water-spot etching. One-step polish ${usd(polish.price)} with a Full Detail or exterior detail. At your home.`;

const faqs = [
  { q: 'What is paint correction?', a: 'Machine polishing that levels the clear coat by a few microns to remove the defects in it: swirl marks, wash marring, light scratches, oxidation, buffer holograms and etched water spots. It is a real repair of the surface, not a glaze or wax that fills defects and washes out a few weeks later.' },
  { q: 'One-step or two-step: which do I need?', a: 'A one-step polish uses a single polish and pad. It removes light swirls and wash marks and brings back most of the gloss, which is right for most daily drivers and newer cars. A two-step starts with a cutting compound for deeper defects and heavy oxidation, then refines with a finishing polish for maximum clarity. It is for dark colors, neglected paint and anyone who wants the paint as close to perfect as it can safely get. We check the paint under light before recommending either.' },
  { q: 'Will it remove every scratch?', a: 'It removes scratches that sit in the clear coat. Run a fingernail across the scratch: if the nail catches, it has gone through the clear and into the color or primer, and polishing cannot remove it without making the clear coat dangerously thin. Those need touch-up paint or a body shop, and we will tell you before we start.' },
  { q: 'Is paint correction safe for my clear coat?', a: 'Yes, done properly. We start with the least aggressive pad and polish that works on a test spot, and only step up if the test spot needs it. A one-step polish removes very little clear coat, which is why it can be done a few times over a car\'s life. That is also why corrected paint should be protected afterwards, so it does not need correcting again.' },
  { q: 'How long does paint correction take?', a: 'A one-step polish adds about one to two hours to a detail on a car. A two-step correction is a full day, and on a large SUV or very neglected paint it can run into a second day. We give you the time with the quote.' },
  { q: 'How much does paint correction cost?', a: `A one-step polish is ${usd(polish.price)} on top of a Full Detail or exterior detail. With a ceramic coating, correction is built into the package: one-step with Silver and two-step with Gold, quoted together with the coating. A standalone two-step correction without a coating is quoted after we see the paint, because how much work it needs varies so much.` },
  { q: 'Can you do it outside?', a: 'Yes, with conditions. Polish does not work properly on hot panels in direct sun, and dust is the enemy. A garage, a carport or a shaded driveway is ideal. We will ask about your parking when you book and plan around it.' },
];

const schema = [
  serviceSchema({
    name: 'Paint Correction',
    description: 'Mobile paint correction in Oakland and the Bay Area: one-step and two-step machine polishing to remove swirl marks, light scratches, oxidation and water-spot etching.',
    path,
    image: '/images/paint-correction-polishing-poster.jpg',
    minPrice: polish.price,
    offers: [
      { name: 'One-step polish', description: 'Single-stage machine polish that removes light swirls and wash marks, added to a Full Detail or exterior detail.', price: String(polish.price) },
      { name: 'Two-step paint correction', description: 'Compound and polish for heavier defects, oxidation and dark paint. Quoted after inspection.' },
    ],
  }),
  faqSchema(faqs),
  breadcrumbSchema([{ label: 'Services', href: '/services/' }, { label: 'Paint Correction', href: path }]),
];

const steps = [
  { title: 'Wash and decontaminate', text: 'Polishing over grit scratches the paint, so every correction starts with a full hand wash, iron remover and clay until the surface is perfectly clean.' },
  { title: 'Inspect under light', text: 'A swirl-finder light shows every defect. We mask trim, rubber and badges, and check for thin spots and repaints before touching the paint.' },
  { title: 'Test spot', text: 'We start on a small section with the gentlest pad and polish and only step up if it does not finish clean. Then we apply what worked to the whole car.' },
  { title: 'Correct panel by panel', text: 'A dual-action polisher, worked slowly in small sections, checked under light after each one. One step or two, depending on the paint.' },
  { title: 'Wipe down and protect', text: 'Panel wipe to remove polishing oils and show the true finish, then sealant or a ceramic coating so the result lasts.' },
];
---

<Base {title} {description} canonical={path} {schema} ogImage="/images/paint-correction-polishing-poster.jpg" preloadImage="/images/paint-correction-polishing-poster.jpg">
  <PageHero
    crumbs={[{ label: 'Services', href: '/services/' }, { label: 'Paint Correction' }]}
    eyebrow="Mobile paint correction"
    titleHtml="Paint Correction in Oakland, <em>swirls and haze polished out</em>"
    text="Machine polishing that takes out the swirl marks, wash scratches and dullness years of car washes leave behind. Done at your home, the least aggressive way that gets the result."
    image="/images/paint-correction-polishing-poster.jpg"
    imageAlt="Jalil machine polishing with a dual-action polisher, the same tool used for paint correction"
    facts={[
      { label: 'One-step polish', value: `${usd(polish.price)} with a Full Detail or exterior detail` },
      { label: 'With ceramic', value: 'Included, quoted per vehicle' },
      { label: 'Time', value: '2 hours to a full day' },
      { label: 'Two-step', value: 'Quoted after inspection' },
    ]}
  />

  <section class="section">
    <div class="container two-col">
      <div class="prose">
        <span class="eyebrow">What it is</span>
        <h2>Polishing, not filling. The marks are actually gone.</h2>
        <p>Look at your car in direct sun or under a gas station light. If the reflections are surrounded by a spiderweb of fine circles, those are swirl marks: thousands of tiny scratches in the clear coat, mostly from brush car washes and dirty towels. They scatter light, which is why the paint looks flat even when it is clean.</p>
        <p>Paint correction removes them by leveling the clear coat with a machine polisher, a few microns at a time, until the surface is smooth again and light reflects straight back. That is where the deep, wet look comes from.</p>
        <p>Most "swirl remover" products fill the scratches with oils that wash out in a couple of weeks. Correction is the repair. The video shows it being done on a real job.</p>
      </div>
      <ServiceVideo
        src="/video/paint-correction-polishing"
        poster="/images/paint-correction-polishing-poster-760w.webp"
        label="J&W Mobile Detailing machine polishing with a dual-action polisher"
      />
    </div>
  </section>

  <section class="section section--soft" id="packages">
    <div class="container">
      <div class="head">
        <span class="eyebrow">Levels and pricing</span>
        <h2>How much correction your paint needs</h2>
        <p class="lead">We check the paint under light before recommending anything, and we will tell you if a one-step <a href="/paint-enhancement/">paint enhancement</a> is enough.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Option</th><th>Best for</th><th>Removes</th><th>Price</th></tr></thead>
          <tbody>
            <tr><td><strong>One-step polish</strong><br /><small>Added to a Full Detail or exterior detail</small></td><td>Daily drivers, newer cars, light wash marks</td><td>Light swirls and wash marring. Restores most of the gloss.</td><td class="price">{usd(polish.price)}</td></tr>
            <tr><td><strong>Two-step correction</strong><br /><small>Compound, then polish</small></td><td>Dark colors, neglected paint, pre-sale or show cars</td><td>Deeper swirls, holograms, heavy oxidation and water-spot etching</td><td class="price">Quoted</td></tr>
            <tr><td><strong>Silver ceramic</strong><br /><small>One-step + coating</small></td><td>Most cars getting a coating</td><td>Light defects removed, then sealed in for years</td><td class="price">Quoted</td></tr>
            <tr><td><strong>Gold ceramic</strong><br /><small>Two-step + coating</small></td><td>Dark or heavily swirled paint getting a coating</td><td>The most defects removed before the coating locks it in</td><td class="price">Quoted</td></tr>
          </tbody>
        </table>
      </div>
      <p class="pc-note">Ceramic packages are quoted for your vehicle and paint. See <a href="/ceramic-coating/">how the packages differ</a>.</p>
    </div>
  </section>

  <Process steps={steps} heading="How we correct paint without risking it" eyebrow="Our process" dark />

  <section class="section">
    <div class="container two-col two-col--top">
      <div>
        <span class="eyebrow">Honest expectations</span>
        <h2>The fingernail test</h2>
        <p class="lead">Run a fingernail lightly across a scratch. If it glides over, the scratch is in the clear coat and polishing can remove it. If it catches, the scratch has gone deeper, and we will not chase it with a polisher.</p>
      </div>
      <div class="honest">
        <div>
          <h3>Polishes out</h3>
          <ul class="checklist">
            <li>Swirl marks from car washes</li>
            <li>Wash marring and towel scratches</li>
            <li>Light scratches from bags, keys and fingernails around handles</li>
            <li>Oxidation and fading on older paint</li>
            <li>Buffer holograms from a bad previous polish</li>
            <li>Etched water spots and bird-dropping marks</li>
          </ul>
        </div>
        <div>
          <h3>Needs paint or a body shop</h3>
          <ul class="xlist">
            <li>Scratches your fingernail catches in</li>
            <li>Rock chips</li>
            <li>Clear coat that is peeling or flaking</li>
            <li>Dents and creases</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container prose max-prose" style="margin-inline:auto">
      <span class="eyebrow">Protect the result</span>
      <h2>Corrected paint is unprotected paint</h2>
      <p>Polishing removes the defects and any old wax or sealant with them. Left bare, the paint starts collecting new swirls and contamination straight away. Every correction we do ends with protection: a ceramic sealant at minimum, or ideally a <a href="/ceramic-coating/">ceramic coating</a>, which is why correction is built into our Silver and Gold coating packages.</p>
      <p>Then wash it gently. The fastest way to undo a correction is a brush car wash. A <a href="/membership/">membership</a> keeps corrected paint washed properly without you having to think about it.</p>

      <h2>Cars we see the most</h2>
      <p>Black and dark-colored cars show swirls the most, so they are most of our corrections. Teslas, Rivians and many newer cars have softer clear coats that mark easily, often straight from the dealer's lot wash. And older cars with faded, oxidized paint often come back further than their owners expect. If you are not sure whether your paint is worth correcting, send us a photo in direct sun.</p>
    </div>
  </section>

  <Reviews limit={3} filterService="Paint Correction" heading="What people say after a correction" />
  <Faq faqs={faqs} heading="Paint correction questions" />
  <QuoteSection eyebrow="Paint correction quote" title="Send us two photos of the paint in direct sun." text="Tell us the car and color. Photos in sunlight show us the swirls and how deep they go, so we can recommend one-step or two-step and confirm the price." />
  <ServicesGrid exclude={path} heading="Other services we bring to you" eyebrow="More from J&W" lead="" />
  <CtaBand title="See your reflection in the paint again." />
</Base>

<style>
  .pc-note { font-size: 0.9rem; color: var(--muted); margin-top: 1rem; }
  .honest { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  @media (max-width: 640px) { .honest { grid-template-columns: 1fr; } }
  .honest > div { border: 1px solid var(--line); border-radius: 20px; padding: 1.4rem; }
  .honest h3 { font-size: 1.1rem; margin-bottom: 0.9rem; }
</style>
