---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { GALLERY, SITE } from '../data/site';
import { breadcrumbSchema } from '../data/schema';

const path = '/gallery/';
const title = 'Gallery | Before & After Detailing Photos | J&W Oakland';
const description =
  'Real before-and-after photos from J&W Mobile Detailing jobs in Oakland & the East Bay — interior resets, paint correction, ceramic coating, RV washes. No stock.';
const imgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'J&W Mobile Detailing — recent work in Oakland & the East Bay',
  url: `${SITE.url}${path}`,
  image: GALLERY.map((g) => ({ '@type': 'ImageObject', contentUrl: `${SITE.url}${g.src}`, caption: g.alt, width: g.w, height: g.h })),
};
const schema = [imgSchema, breadcrumbSchema([{ label: 'Gallery', href: path }])];
---

<Base {title} {description} canonical={path} {schema} ogImage="/images/work-1.jpg">
  <PageHero
    crumbs={[{ label: 'Gallery' }]}
    eyebrow="Recent work"
    titleHtml="Real cars, real driveways, <em>no filters</em>"
    text="A selection of recent J&W jobs across Oakland and the East Bay. For daily photos and videos — coatings, interior rescues, paint correction under the light — follow @jnwdetail on Instagram."
    image="/images/work-1.jpg"
    imageAlt="Black sedan freshly ceramic coated by J&W Mobile Detailing in an Oakland driveway"
  />

  <section class="section">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Before / after</span>
        <h2>Interior Deep Shampoo — Oakland</h2>
        <p class="lead">Drag the slider. Cloth seat, years of wear, one visit: pre-treat, hot-water extraction, steam.</p>
        <a href="/interior-auto-detailing-oakland-california/" class="btn btn--dark">Interior detailing packages</a>
      </div>
      <BeforeAfter before="/images/interior-detailing-oakland-before.jpg" after="/images/interior-detailing-oakland-after.jpg" altBefore="Before: stained cloth seat prior to interior detailing in Oakland" altAfter="After: the same seat shampoo-extracted and steam cleaned by J&W" />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="ggrid">
        {GALLERY.map((g) => (
          <figure>
            <img src={g.src} alt={g.alt} width={g.w} height={g.h} loading="lazy" decoding="async" />
            <figcaption>{g.label}</figcaption>
          </figure>
        ))}
      </div>
      <div class="center" style="margin-top:2rem">
        <a href={SITE.social.instagram} class="btn btn--dark" target="_blank" rel="noopener">More on Instagram @jnwdetail</a>
      </div>
    </div>
  </section>

  <QuoteSection />
  <CtaBand title="Want yours in here?" text="Book a detail and send us your own before/after — we love posting them." />
</Base>

<style>
  .ggrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  @media (max-width: 900px) { .ggrid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .ggrid { grid-template-columns: 1fr; } }
  figure { margin: 0; border-radius: var(--radius); overflow: hidden; background: #000; position: relative; aspect-ratio: 4/3; }
  figure img { width: 100%; height: 100%; object-fit: cover; }
  figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 0.6rem 0.9rem; background: linear-gradient(transparent, rgba(0,0,0,0.7)); color: #fff; font-size: 0.85rem; font-weight: 600; }
</style>
