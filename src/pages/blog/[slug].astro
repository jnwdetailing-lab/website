---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import Icon from '../../components/Icons.astro';
import { SITE, CTA } from '../../data/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../data/schema';
import { DETAIL, EXTERIOR_ONLY, MONTHLY_FROM, from, usd } from '../../data/pricing';
import { fillTokens, postFaqs } from '../../data/blog';
import meta from '../../content/blog/meta.json';

export async function getStaticPaths() {
  const files = import.meta.glob('../../content/blog/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
  return meta.map((m) => ({
    params: { slug: m.slug },
    props: { ...m, html: files[`../../content/blog/${m.slug}.html`] },
  }));
}
const { slug, title: postTitle, date, updated, html } = Astro.props as { slug: string; title: string; date: string; updated?: string; html: string };
// Prices come from pricing.ts (see src/data/blog.ts). Each table then scrolls
// inside its own box on a phone instead of widening the page.
const body = fillTokens(html, slug).replace(/<table\b/g, '<div class="post__table"><table').replace(/<\/table>/g, '</table></div>');
const faqs = postFaqs(body);
const path = `/blog/${slug}/`;

const seo: Record<string, { title: string; description: string; image: string }> = {
  'car-wash-vs-full-detail': {
    title: "Car Wash vs. Full Detail: What's the Difference? | J&W",
    description: 'A car wash cleans the surface. A full detail resets the paint and the cabin. What each one covers, how to tell which your car needs, and what it costs in Oakland.',
    image: '/images/hero-oakland-mobile-detailing.webp',
  },
  'is-car-detailing-worth-it': {
    title: 'Is Car Detailing Worth It? Benefits vs. Cost | J&W Oakland',
    description: "When a professional detail pays off and when it doesn't: paint, interior, resale and your time, from an Oakland detailer who prices every job upfront.",
    image: '/images/paint-correction-polishing-oakland.jpg',
  },
  'what-does-a-car-detailer-do': {
    title: 'What Does a Car Detailer Do? Step by Step | J&W Oakland',
    description: 'Every step a professional detailer does inside and out, in the order it happens, plus what is included in a full detail and what is an add-on. From an Oakland detailer.',
    image: '/images/interior-detailing-steam-cleaning-oakland.jpg',
  },
  'how-much-to-tip-for-car-detailing': {
    title: 'How Much to Tip for a Car Detail (2026) | J&W Oakland',
    description: 'Tipping a detailer is optional. Most guides say 15 to 20 percent, about $30 to $40 on a $200 detail. When to tip more or less, and where J&W tips go.',
    image: '/images/jalil-owner-jw-mobile-detailing-oakland.jpg',
  },
  'how-often-should-you-detail-your-car': {
    title: 'How Often Should You Detail Your Car? | J&W Oakland',
    description: 'Monthly to keep it always fresh, every three months for most drivers, and what changes that: kids, pets, commuting and street parking. From an Oakland detailer.',
    image: '/images/exterior-detailing-oakland.jpg',
  },
  'whats-included-in-a-full-detailing-service': {
    title: "What's Included in a Full Detail? Checklist, Time & Oakland Cost",
    description: `What a full detail includes inside and out, what is an add-on, how long it takes (${DETAIL.hoursInsideOut}) and what it costs in Oakland: from ${usd(from(DETAIL.insideOut))} at J&W.`,
    image: '/images/exterior-detailing-oakland.jpg',
  },
  'what-does-ceramic-coating-cost-in-oakland-ca': {
    title: 'Ceramic Coating Cost in Oakland, CA (2026): What Drives the Price',
    description: 'What a professional ceramic coating costs in Oakland and the Bay Area, what the price includes, why cheap quotes skip the prep, and how J&W quotes your vehicle.',
    image: '/images/blog/compressed-watermarked_img_17093029742238375971.jpg',
  },
  'what-does-auto-detailing-cost-in-oakland-ca': {
    title: 'Auto Detailing Cost in Oakland, CA (2026 Price Guide) | J&W',
    description: `Oakland detailing prices at J&W: Full Detail ${DETAIL.insideOut.map(usd).join(' / ')} by size, interior only from ${usd(from(DETAIL.interiorOnly))}, exterior only ${usd(EXTERIOR_ONLY.prices[0])}, plans from ${usd(MONTHLY_FROM)} a visit.`,
    image: '/images/blog/car-detailing-cost-in-oakland-featured-image.jpg',
  },
};
const s = seo[slug];
const schema = [
  articleSchema({ title: postTitle, path, date, updated, image: s.image, description: s.description }),
  ...(faqs.length ? [faqSchema(faqs)] : []),
  breadcrumbSchema([{ label: 'Blog', href: '/blog/' }, { label: postTitle, href: path }]),
];
const fmt = new Date((updated ?? date) + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base title={s.title} description={s.description} canonical={path} {schema} ogImage={s.image}>
  <article class="post">
    <header class="post__head">
      <div class="container">
        <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }, { label: postTitle }]} light />
        <h1>{postTitle}</h1>
        <p class="post__meta">By <a href="/about-us/">{SITE.founder}</a>, founder of J&W Mobile Detailing · Updated {fmt} · Oakland, CA</p>
      </div>
    </header>
    <div class="container post__body">
      <img class="post__hero" src={s.image} alt={postTitle} width="1376" height="768" fetchpriority="high" decoding="async" />
      <div set:html={body} />
      <aside class="author">
        <img src="/images/jalil-owner-jw-mobile-detailing-oakland.jpg" alt="Jalil Wren, founder of J&W Mobile Detailing" width="96" height="96" loading="lazy" />
        <div>
          <strong>About the author</strong>
          <p>{SITE.founder} founded J&W Mobile Detailing in Oakland in 2022 and still details every car the company takes on. Ceramic coatings, paint correction, interiors, 1,000+ Bay Area vehicles and a 4.9★ Google rating.</p>
          <div class="btn-row"><a href={CTA.href} class="btn btn--primary btn--sm" data-scroll-book><Icon name="calendar" /> {CTA.label}</a><a href="/about-us/" class="btn btn--ghost btn--sm">About J&W</a></div>
        </div>
      </aside>
    </div>
  </article>
  <QuoteSection />
  <CtaBand />
</Base>

<style is:global>
  .post__head { background: linear-gradient(160deg, #171a20, var(--ink)); color: #d7dae0; padding: 2.5rem 0 3rem; }
  .post__head h1 { color: #fff; font-size: clamp(2rem, 4.5vw, 3.4rem); max-width: 24ch; }
  .post__meta { color: #b9bec8; margin: 0; }
  .post__meta a { color: #fff; }
  .post__body { max-width: 860px; padding-top: 2rem; padding-bottom: 3rem; }
  .post__hero { border-radius: var(--radius); margin-bottom: 2rem; box-shadow: var(--shadow); }
  .author { display: flex; gap: 1.25rem; align-items: flex-start; background: var(--bg-soft); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; margin-top: 3rem; }
  .author img { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; flex: none; }
  .author strong { font-family: var(--font-display); text-transform: uppercase; font-size: 1.1rem; color: var(--ink); }
  .author p { margin: 0.35rem 0 0.8rem; font-size: 0.95rem; color: var(--muted); }
  /* The imported post HTML carries its own scoped CSS; make sure images never overflow */
  .post__body img { max-width: 100%; height: auto; }
  /* !important + extra class: the imported posts reset every element inside them with all: revert !important. */
  .post__body .post__table { display: block !important; max-width: 100% !important; overflow-x: auto !important; -webkit-overflow-scrolling: touch; }
  @media (max-width: 560px) { .author { flex-direction: column; } }
</style>
