---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import { breadcrumbSchema } from '../../data/schema';
import meta from '../../content/blog/meta.json';
import { DETAIL, EXTERIOR_ONLY, MONTHLY_FROM, from, usd } from '../../data/pricing';

const path = '/blog/';
const title = 'Detailing Guides & Oakland Pricing | J&W Mobile Detailing Blog';
const description =
  'Straight-talk guides from an Oakland detailer: what detailing and ceramic coating cost in Oakland, what a full detail includes, how to protect Bay Area paint.';
const images: Record<string, string> = {
  'car-wash-vs-full-detail': '/images/hero-oakland-mobile-detailing.webp',
  'is-car-detailing-worth-it': '/images/interior-detailing-oakland-after.jpg',
  'what-does-a-car-detailer-do': '/images/interior-detailing-steam-cleaning-oakland.jpg',
  'how-much-to-tip-for-car-detailing': '/images/jalil-owner-jw-mobile-detailing-oakland.jpg',
  'how-often-should-you-detail-your-car': '/images/exterior-detailing-oakland.jpg',
  'whats-included-in-a-full-detailing-service': '/images/exterior-detailing-oakland.jpg',
  'what-does-ceramic-coating-cost-in-oakland-ca': '/images/blog/compressed-watermarked_img_17093029742238375971.jpg',
  'what-does-auto-detailing-cost-in-oakland-ca': '/images/blog/car-detailing-cost-in-oakland-featured-image.jpg',
};
const excerpts: Record<string, string> = {
  'car-wash-vs-full-detail': 'What a wash handles, what only a full detail reaches, and two quick checks that tell you which one your car needs right now.',
  'is-car-detailing-worth-it': 'When a professional detail pays off, when it does not, and how to get the most out of one. Straight answers, prices upfront.',
  'what-does-a-car-detailer-do': 'Every step inside and out, why the order matters, and what is part of a full detail versus an add-on.',
  'how-much-to-tip-for-car-detailing': 'Is tipping expected, what is normal, when to tip more or less, and where tips go at J&W.',
  'how-often-should-you-detail-your-car': 'Monthly, every two months or quarterly: how to pick a detailing schedule that fits your car and your routine.',
  'whats-included-in-a-full-detailing-service': `Every step in our Full Detail, what is an add-on, how long it takes (${DETAIL.hoursInsideOut}) and what it costs in Oakland.`,
  'what-does-ceramic-coating-cost-in-oakland-ca': 'What drives the price of a ceramic coating, what a complete job includes, why cheap quotes skip the prep, and how to keep it looking new.',
  'what-does-auto-detailing-cost-in-oakland-ca': `Full Detail from ${usd(from(DETAIL.insideOut))}, interior only from ${usd(from(DETAIL.interiorOnly))}, exterior only ${usd(EXTERIOR_ONLY.prices[0])}, plans from ${usd(MONTHLY_FROM)} a visit. The full Oakland price breakdown.`,
};
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const schema = [breadcrumbSchema([{ label: 'Blog', href: path }])];
---

<Base {title} {description} canonical={path} {schema}>
  <PageHero
    crumbs={[{ label: 'Blog' }]}
    eyebrow="Guides"
    titleHtml="Detailing guides written by <em>the people who do the work</em>"
    text="No fluff, no affiliate links. Real Oakland prices, real process, and honest answers to the questions customers ask us on the phone."
  />
  <section class="section">
    <div class="container grid grid--3">
      {meta.map((p) => (
        <a href={`/blog/${p.slug}/`} class="card post">
          <img class="card__img" src={images[p.slug]} alt="" width="800" height="600" loading="lazy" decoding="async" />
          <div class="card__body">
            <span class="pill">Updated {fmt(p.updated ?? p.date)}</span>
            <h3>{p.title}</h3>
            <p>{excerpts[p.slug]}</p>
            <span class="card__link">Read the guide</span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <QuoteSection />
  <CtaBand />
</Base>
<style>.post { color: inherit; text-decoration: none !important; }</style>
