---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteSection from '../components/QuoteSection.astro';
import AreasGrid from '../components/AreasGrid.astro';
import Icon from '../components/Icons.astro';
import { SITE } from '../data/site';
import { breadcrumbSchema } from '../data/schema';

const path = '/about-us/';
const title = 'About J&W Mobile Detailing | Owner-Operated in Oakland Since 2022';
const description =
  'Meet Jalil Wren, founder of J&W Mobile Detailing — Oakland\'s owner-operated mobile detailing & ceramic coating company since 2022. Eco-friendly, 4.9★ on Google.';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/about-us/#jalil`,
  name: SITE.founder,
  jobTitle: 'Founder & Lead Detailer',
  worksFor: { '@id': `${SITE.url}/#business` },
  image: `${SITE.url}/images/jalil-owner-jw-mobile-detailing-oakland.jpg`,
  url: `${SITE.url}/about-us/`,
  knowsAbout: ['Ceramic coating', 'Paint correction', 'Interior detailing', 'Exterior detailing', 'Mobile auto detailing', 'RV detailing'],
  sameAs: [SITE.social.instagram, SITE.social.facebook],
};
const schema = [person, breadcrumbSchema([{ label: 'About Us', href: path }])];
---

<Base {title} {description} canonical={path} {schema} ogImage="/images/jalil-owner-jw-mobile-detailing-oakland.jpg">
  <PageHero
    crumbs={[{ label: 'About Us' }]}
    eyebrow="About J&W"
    titleHtml="Owner-operated mobile detailing, <em>founded in Oakland in 2022</em> — and still done by the owner"
    text="J&W Mobile Detailing is Jalil Wren and a small team, one well-equipped van, eco-friendly products, and a standard that has not moved since day one: every vehicle leaves looking the way we'd want our own to."
    image="/images/jalil-owner-jw-mobile-detailing-oakland.jpg"
    imageAlt="Jalil Wren, founder of J&W Mobile Detailing, detailing a steering wheel in Oakland, CA"
  />

  <section class="section">
    <div class="container two-col">
      <div class="prose">
        <span class="eyebrow">The story</span>
        <h2 class="mt-0">From detailing friends' cars to 1,000+ East Bay vehicles</h2>
        <p>Jalil has had a passion for vehicles his entire life. Long before J&W Mobile Detailing was ever a business, he was detailing cars on his own — sharpening his craft and falling in love with the process of bringing a tired, dirty vehicle back to life. Learning what actually pulls a stain out of a seat. What takes swirls out of black paint without burning it. Which "full details" are really just a wash.</p>
        <p>That passion turned into something bigger in the fall of 2022, when Jalil officially founded J&W Mobile Detailing in Oakland. What started as a personal love for cars became a commitment to the whole East Bay: <strong>high-quality mobile detailing, done right, delivered wherever it's most convenient for you.</strong> Today Jalil and his team specialize in ceramic coatings, paint correction, interior and exterior detailing, and RV washes — bringing showroom-quality results straight to homes and workplaces from Alameda to Walnut Creek.</p>
        <p>1,000+ vehicles and 220+ five-star Google reviews later, the standard is the same. So is the guy.</p>
      </div>
      <div class="stats">
        <div><strong>2022</strong><span>Founded in Oakland</span></div>
        <div><strong>{SITE.rating.value}★</strong><span>{SITE.rating.count} Google reviews</span></div>
        <div><strong>1,000+</strong><span>Vehicles detailed</span></div>
        <div><strong>8</strong><span>East Bay cities served</span></div>
        <div><strong>100%</strong><span>Mobile — own water & power</span></div>
        <div><strong>0</strong><span>Rotating crews. The owner shows up.</span></div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="center" style="margin-bottom:2rem">
        <span class="eyebrow">What we stand for</span>
        <h2>Four things we won't compromise on</h2>
      </div>
      <div class="grid grid--4">
        <div class="val"><Icon name="user" size={30} /><h3>Owner accountability</h3><p>When you book J&W, you get the owner's personal attention and pride on every job — not a rotating crew that treats your car like a number. You'll have Jalil's number.</p></div>
        <div class="val"><Icon name="dollar" size={30} /><h3>Transparent pricing</h3><p>Real price ranges on every page of this site. An exact quote for your vehicle before we book. No hidden costs, no surprise upsells at the walk-around.</p></div>
        <div class="val"><Icon name="leaf" size={30} /><h3>Eco-friendly products</h3><p>One of the only detailing services in the Bay Area using eco-friendly, biodegradable, pH-neutral products — better for your vehicle, better for your family, better for the environment.</p></div>
        <div class="val"><Icon name="sparkle" size={30} /><h3>Systematic, every time</h3><p>An extremely detailed, systematic approach: the same checklist on every vehicle, every imperfection addressed, and a walk-around with you under light before you pay.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div class="img-frame"><img src="/images/interior-detailing-steam-cleaning-oakland.jpg" alt="Jalil steam cleaning the rear seat of an SUV during a mobile interior detail" width="1080" height="1080" loading="lazy" decoding="async" /></div>
      <div class="prose">
        <span class="eyebrow">How we work</span>
        <h2 class="mt-0">A shop on wheels, parked in your driveway</h2>
        <p>The van carries everything: water tank, generator, pressure washer, foam cannon, dry-vapor steamer, commercial hot-water extractor, compressor, dual-action polishers, LED inspection lighting, ozone generator, and pH-balanced chemistry for paint, fabric, leather, plastics and screens. You don't provide a hose, an outlet, or a ride to a shop.</p>
        <p>We serve Oakland, Alameda, Berkeley, San Leandro, Piedmont, Emeryville, Orinda and Walnut Creek, seven days a week, {SITE.hours.label.replace('Mon – Sun · ', '')}. Licensed and insured. Cash, card, Zelle or Venmo — after you've inspected the work.</p>
        <div class="btn-row">
          <a href="/services/" class="btn btn--dark">Services & pricing</a>
          <a href="/gallery/" class="btn btn--ghost">See our work</a>
        </div>
      </div>
    </div>
  </section>

  <Reviews limit={6} heading="Don't take our word for it" />
  <AreasGrid compact />
  <QuoteSection />
  <CtaBand title="Want to meet the guy who'll actually detail your car?" text="Call or text Jalil directly, or book online and he'll confirm personally." />
</Base>

<style>
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .stats div { background: var(--ink); color: #fff; border-radius: var(--radius); padding: 1.5rem 1.25rem; }
  .stats strong { display: block; font-family: var(--font-display); font-size: 2.6rem; line-height: 1; color: #fff; margin-bottom: 0.35rem; }
  .stats span { font-size: 0.9rem; color: #b9bec8; }
  .val { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; }
  .val svg { color: var(--red); margin-bottom: 0.75rem; }
  .val h3 { font-size: 1.3rem; }
  .val p { margin: 0; font-size: 0.95rem; color: var(--muted); }
</style>
