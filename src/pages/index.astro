---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icons.astro';
import QuoteForm from '../components/QuoteForm.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Reviews from '../components/Reviews.astro';
import ComeToYou from '../components/ComeToYou.astro';
import PriceExplorer from '../components/PriceExplorer.astro';
import MembershipPlans from '../components/MembershipPlans.astro';
import WorkGallery from '../components/WorkGallery.astro';
import TrustindexWidget from '../components/TrustindexWidget.astro';
import { srcsetFor } from '../lib/srcset';
import { SITE, HOME_FAQS, CTA, BOOK, AREAS, GOOGLE_MAP_EMBED, BBB, TRUSTINDEX } from '../data/site';
import { DETAIL, from, usd } from '../data/pricing';

const title = 'Mobile Car Detailing Oakland, CA | J&W Mobile Detailing';
const description = `Mobile car detailing in Oakland and the Bay Area, done at your home or office. Full Detail from ${usd(from(DETAIL.insideOut))}, ceramic coating, memberships. 4.9★ on Google.`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

// ── HERO ────────────────────────────────────────────────────────────────────
// Built to take a background video: drop the file in /public/video/ and put its
// path in HERO_VIDEO. HERO_POSTER is the still that paints first, and what
// visitors who prefer reduced motion see.
const HERO_VIDEO = ''; // e.g. '/video/hero.mp4'
const HERO_POSTER = '/images/hero-oakland-mobile-detailing.webp';
const HERO_SRCSET = srcsetFor(HERO_POSTER, 1080);
const HERO_SIZES = '100vw';
---

<Base {title} {description} canonical="/" schema={[faqSchema]} bodyClass="home" ogImage="/images/og-default.jpg" preloadImage={HERO_POSTER} preloadImageSrcset={HERO_SRCSET} preloadImageSizes={HERO_SIZES}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero__card">
      <div class="hero__media" aria-hidden="true">
        {HERO_VIDEO ? (
          <video class="hero__vid" src={HERO_VIDEO} poster={HERO_POSTER} autoplay muted loop playsinline preload="metadata"></video>
        ) : (
          <img class="hero__vid" src={HERO_POSTER} srcset={HERO_SRCSET} sizes={HERO_SIZES} alt="" width="1080" height="608" fetchpriority="high" decoding="async" />
        )}
        <div class="hero__scrim"></div>
      </div>

      <div class="container hero__inner">
        {/* Live Google rating from Trustindex. The static pill shows until it draws, at the same size. */}
        <TrustindexWidget code={TRUSTINDEX.hero} eager inline minHeight={62} class="hero__ti">
          <a href={SITE.social.google} class="hero__proof" target="_blank" rel="noopener">
            <span class="hero__g" aria-hidden="true">G</span>
            <strong>{SITE.rating.value}</strong>
            <span class="stars" role="img" aria-label={`${SITE.rating.value} out of 5 stars`}>{Array.from({ length: 5 }).map(() => <Icon name="star" size={17} />)}</span>
            <span>{SITE.rating.count} reviews</span>
          </a>
        </TrustindexWidget>
        {!TRUSTINDEX.hero && (
          <a href={SITE.social.google} class="hero__proof hero__ti" target="_blank" rel="noopener">
            <span class="hero__g" aria-hidden="true">G</span>
            <strong>{SITE.rating.value}</strong>
            <span class="stars" role="img" aria-label={`${SITE.rating.value} out of 5 stars`}>{Array.from({ length: 5 }).map(() => <Icon name="star" size={17} />)}</span>
            <span>{SITE.rating.count} reviews</span>
          </a>
        )}
        <h1>Top-Rated Mobile Car Detailing & Ceramic Coating in Oakland, CA</h1>
        <p class="hero__sub">We bring the water, the power and a fully stocked van to your driveway, office or apartment. You get a car that looks and smells new, without losing a Saturday at a shop.</p>

        <div class="hero__actions">
          <a href="#book" class="btn btn--primary btn--lg" data-scroll-book>{CTA.label}</a>
          <a href={BOOK.href} class="btn btn--light btn--lg"><Icon name="calendar" /> {BOOK.label}</a>
          <a href={`tel:${SITE.phoneE164}`} class="btn btn--ghost-light btn--lg hero__call"><Icon name="phone" /> {SITE.phoneDisplay}</a>
        </div>

        <ul class="hero__trust" aria-label="Why customers trust us">
          <li><Icon name="user" size={16} /> Trusted by 400+ customers</li>
          <li><Icon name="star" size={16} /> 5-star experience</li>
          <li><Icon name="shield" size={16} /> 100% satisfaction guarantee</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ QUOTE: the #quote / #book target every CTA scrolls to ============ -->
  <section class="section--tight booking" id="quote">
    <div class="container booking__inner">
      <div class="booking__copy">
        <span class="eyebrow">Get your price</span>
        <h2>Tell us the car. We text back a price and a time.</h2>
        <ol class="booking__steps">
          <li><b>1</b><span><strong>Tell us what you drive</strong> and where it parks. About 30 seconds.</span></li>
          <li><b>2</b><span><strong>We confirm the price</strong> and the next openings, usually within minutes during business hours.</span></li>
          <li><b>3</b><span><strong>We come to you</strong>, and you look the car over with us before we leave.</span></li>
        </ol>
        <p class="booking__alt">Know what you want? <a href={BOOK.href}>Book a time online</a> or call / text <a href={`tel:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a>.</p>
      </div>
      <section id="book" class="book" tabindex="-1" aria-label="Request a quote">
        <QuoteForm bare compact />
      </section>
    </div>
  </section>

  <Reviews limit={6} heading="What Bay Area drivers say after we leave" />

  <ComeToYou />

  <PriceExplorer />

  <MembershipPlans />

  <!-- ============ WHY J&W ============ -->
  <section class="section">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Why people switch to us</span>
        <h2>What a detail does that a car wash can't</h2>
        <p class="lead">A tunnel wash drags the last hundred cars' grit across your paint and leaves the inside alone. We wash by hand with clean mitts, pull bonded contamination off with iron remover and clay, and take the cabin apart: vents, seat rails, cup holders, the carpet under the mats.</p>
        <ul class="checklist why">
          <li><strong>Hand wash only.</strong> No brushes, ever, so we never add the swirls a tunnel wash does.</li>
          <li><strong>Extraction, not just a vacuum.</strong> Steam and hot-water extraction pull out what a vacuum leaves in the fibers.</li>
          <li><strong>One checklist on every car.</strong> The same steps whether it is a Civic or a Range Rover.</li>
          <li><strong>You inspect it with us.</strong> We walk the car together before we pack up.</li>
        </ul>
        <p class="why__drag">Drag the slider: one cloth seat from a real Oakland job, before and after extraction.</p>
      </div>
      <BeforeAfter
        before="/images/interior-detailing-oakland-before.webp"
        after="/images/interior-detailing-oakland-after.webp"
        altBefore="Before: heavily stained cloth seat in a sedan prior to interior detailing in Oakland"
        altAfter="After: the same seat shampoo-extracted and steam-cleaned by J&W Mobile Detailing"
      />
    </div>
  </section>

  <WorkGallery />

  <!-- ============ AREAS ============ -->
  <section class="section">
    <div class="container">
      <div class="head">
        <span class="eyebrow">Service areas</span>
        <h2>Based in Oakland. Booked across the Bay Area.</h2>
        <p class="lead">The van leaves from East Oakland most mornings. These are the cities we work in every week. Just outside them? Call, and we will usually make it work.</p>
      </div>
      <div class="areas">
        {AREAS.map((a) => (
          <a class="area" href={a.slug}>
            <h3>{a.city}</h3>
            <p>{a.blurb}</p>
            <span class="area__hoods">{a.neighborhoods.slice(0, 4).join(' · ')}</span>
          </a>
        ))}
      </div>
      <p class="center" style="margin-top:1.5rem"><a href="/service-areas/">Every area we cover →</a></p>
    </div>
  </section>

  <!-- ============ FAQ (+ Oakland local copy) ============ -->
  <Faq faqs={HOME_FAQS} heading="Before you book" single open={0}>
    <p slot="intro">Oakland sits between the Bay and the hills, and your car pays for the view: the marine layer leaves salt on every panel overnight, stop-and-go traffic on I-880 and I-580 bakes iron-rich brake dust into clear coat, and street trees from Lake Merritt to Piedmont Avenue drop sap that etches in days. A tunnel wash adds swirls; <a href="/exterior-auto-detailing-oakland-california/">exterior detailing</a> with clay and iron remover pulls the contamination out, a sealant or <a href="/ceramic-coating/">ceramic coating</a> keeps it off, and our <a href="/interior-auto-detailing-oakland-california/">interior detailing</a> is built around steam and shampoo extraction, not a vacuum and a wipe. Text <a href={`sms:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a> if your question isn't here.</p>
  </Faq>

  <!-- ============ LOCATION + CREDIBILITY ============ -->
  <section class="section" id="find-us">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Based in Oakland</span>
        <h2>Where we work from</h2>
        <p class="lead">We are a mobile service, so the van comes to your home or workplace. This is our Oakland base, and we cover the city and the wider Bay Area from here.</p>
        <p class="findus__addr"><Icon name="pin" /> {SITE.address.street}, {SITE.address.city}, {SITE.address.region} {SITE.address.zip}</p>
        <p><a href="/service-areas/">See every area we cover</a></p>
        <!-- rel="nofollow" is BBB's own requirement on the seal link. -->
        {BBB.profileUrl && BBB.sealImage && (
          <a class="findus__bbb" href={BBB.profileUrl} target="_blank" rel="nofollow noopener">
            <img src={BBB.sealImage} alt="J&W Mobile Detailing BBB Business Review" width={BBB.sealWidth} height={BBB.sealHeight} loading="lazy" decoding="async" />
          </a>
        )}
      </div>
      <div class="findus__map">
        <iframe src={GOOGLE_MAP_EMBED} title="J&W Mobile Detailing on Google Maps" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <CtaBand title="Ready when you are. We bring everything." href="#book" />
</Base>

<style>
  /* Hero: a rounded photo card inside the page margins. */
  .hero { padding: clamp(0.5rem, 1.5vw, 1rem) clamp(0.5rem, 1.5vw, 1rem) 0; }
  .hero__card { position: relative; isolation: isolate; max-width: 1320px; margin-inline: auto; border-radius: var(--radius-lg); overflow: hidden; background: var(--ink); color: #dfe3e8; min-height: clamp(520px, 74vh, 700px); display: grid; align-items: end; }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__vid { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Dark from the left and bottom so white type clears contrast on any frame. */
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(13,15,18,0.86) 0%, rgba(13,15,18,0.62) 55%, rgba(13,15,18,0.35) 100%), linear-gradient(0deg, rgba(13,15,18,0.75) 0%, rgba(13,15,18,0) 55%); }
  .hero__inner { padding: clamp(3rem, 8vw, 5rem) 0 clamp(2rem, 5vw, 3.5rem); max-width: var(--container); }
  /* Review badge: the static pill matches the Trustindex badge's size (62px) so the swap does not move anything. */
  .hero__inner :global(.hero__ti) { margin-bottom: 1.1rem; }
  .hero__proof { display: inline-flex; align-items: center; gap: 0.55rem; height: 62px; background: #fff; color: #111; padding: 0 1.35rem; border-radius: 10px; font-size: 0.95rem; font-weight: 600; text-decoration: none !important; }
  .hero__proof strong { font-size: 1rem; }
  .hero__proof .stars { color: #f6bb06; display: inline-flex; }
  .hero__g { width: 24px; height: 24px; border-radius: 50%; background: conic-gradient(#ea4335 0 25%, #fbbc05 0 50%, #34a853 0 75%, #4285f4 0); color: #fff; font-weight: 800; font-size: 0.8rem; display: grid; place-items: center; }
  .hero h1 { color: #fff; max-width: 17ch; font-size: clamp(2.2rem, 5.2vw, 4rem); margin-bottom: 1rem; }
  .hero__sub { font-size: clamp(1.05rem, 1.7vw, 1.22rem); color: #d4d8de; max-width: 52ch; margin-bottom: 1.4rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .hero__trust { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .hero__trust li { display: inline-flex; align-items: center; gap: 0.45rem; margin: 0; background: rgba(255,255,255,0.09); border: 1px solid rgba(255,255,255,0.16); color: #fff; font-size: 0.9rem; font-weight: 600; padding: 0.45rem 0.85rem; border-radius: 999px; }
  .hero__trust :global(svg) { color: #ff6b75; flex: none; }
  @media (max-width: 640px) {
    .hero__card { min-height: 0; }
    .hero__actions { flex-direction: column; align-items: stretch; }
    .hero__actions .btn { width: 100%; }
    .hero__call { display: none; }
  }

  /* Quote card */
  .booking { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .booking__inner { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  @media (max-width: 900px) { .booking__inner { grid-template-columns: 1fr; } }
  .booking__copy { position: sticky; top: calc(var(--nav-h) + 1.5rem); }
  @media (max-width: 900px) { .booking__copy { position: static; } }
  .booking__steps { list-style: none; padding: 0; margin: 1.25rem 0; display: grid; gap: 0.9rem; }
  .booking__steps li { display: flex; gap: 0.8rem; align-items: flex-start; margin: 0; }
  .booking__steps b { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font-size: 0.85rem; }
  .booking__alt { color: var(--muted); font-size: 0.95rem; }
  .book { background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow); padding: clamp(1.1rem, 3vw, 1.75rem); scroll-margin-top: calc(var(--nav-h) + 1rem); }
  .book:focus { outline: none; box-shadow: var(--shadow), 0 0 0 3px var(--red); }

  .why { margin-top: 1.5rem; }
  .why__drag { font-size: 0.9rem; color: var(--muted); margin: 0; }

  .areas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  @media (max-width: 900px) { .areas { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .areas { grid-template-columns: 1fr; } }
  .area { display: flex; flex-direction: column; gap: 0.4rem; border: 1px solid var(--line); border-radius: 20px; padding: 1.3rem 1.4rem; color: inherit; text-decoration: none !important; transition: border-color 0.15s, transform 0.15s; }
  .area:hover { border-color: var(--ink); transform: translateY(-2px); }
  .area h3 { margin: 0; font-size: 1.2rem; }
  .area p { margin: 0; font-size: 0.93rem; color: var(--muted); }
  .area__hoods { margin-top: auto; padding-top: 0.5rem; font-size: 0.8rem; font-weight: 600; color: var(--ink); }

  .findus__addr { display: flex; align-items: center; gap: 0.5rem; color: var(--muted); font-size: 0.95rem; }
  .findus__addr :global(svg) { width: 1.05em; height: 1.05em; flex: none; color: var(--ink); }
  .findus__bbb { display: inline-block; margin-top: 1.25rem; }
  .findus__bbb img { width: 250px; max-width: 100%; height: auto; }
  .findus__map { border-radius: 20px; overflow: hidden; border: 1px solid var(--line); background: #fff; }
  .findus__map iframe { display: block; width: 100%; height: 380px; border: 0; }
  @media (max-width: 900px) { .findus__map iframe { height: 300px; } }
</style>

<script>
  // Smooth-scroll CTAs to the quote card and move focus into it.
  document.querySelectorAll<HTMLAnchorElement>('[data-scroll-book]').forEach((a) =>
    a.addEventListener('click', (e) => {
      const t = document.getElementById('book');
      if (!t) return;
      e.preventDefault();
      t.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => t.focus({ preventScroll: true }), 400);
      history.replaceState(null, '', '#book');
    })
  );

  // Background clip never autoplays for visitors who ask for reduced motion.
  const heroVid = document.querySelector('.hero__vid');
  if (heroVid instanceof HTMLVideoElement && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    heroVid.removeAttribute('autoplay');
    heroVid.pause();
  }
</script>
