---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { EXTERIOR_ONLY, addonPrice, from, usd } from '../data/pricing';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../data/schema';

const path = '/paint-sealant/';
const sealant = addonPrice('Ceramic sealant upgrade (6 months)');
const clay = addonPrice('Clay bar treatment');
const polish = addonPrice('Polish');
const exteriorOnly = from(EXTERIOR_ONLY.prices);
const title = 'Paint Sealant Oakland, CA | 6-Month Ceramic Sealant | J&W';
const description = `Mobile paint sealant in Oakland: a ceramic sealant in place of the spray wax, about six months of protection from sap, salt air and brake dust. ${usd(sealant)}, any size.`;

const faqs = [
  { q: 'How much is the paint sealant?', a: `${usd(sealant)}, the same on a two-door coupe or a full-size truck. It is an add-on to a Full Detail or an Exterior Only Detail (${usd(exteriorOnly)}), not a visit of its own. You book the detail, add the sealant, and the detail price goes up by ${usd(sealant)}. That is the whole math.` },
  { q: 'How long does it last?', a: 'About six months on a car that is washed gently. Brush tunnel washes, strong degreasers and parking under sap-dropping trees all shorten it. Most people who park outside add it once or twice a year, timed with a detail.' },
  { q: 'Can I wash the car myself afterwards?', a: 'Yes. Use a pH-neutral car shampoo and a clean mitt, or a touchless car wash. Skip brush and cloth tunnels, which wear any protection down fast. Rinsing sap, bird droppings and brake dust off before they sit helps it go the full stretch.' },
  { q: 'Will a sealant stop scratches and swirl marks?', a: 'No. It is a barrier against sap, bird droppings, salt and road film, not against a careless scrape or a bad wash. It also will not hide swirls that are already there. Those need polishing first.' },
  { q: 'Should I add a clay bar or a polish first?', a: `Only if the paint needs it. Paint that feels rough after a wash gets the clay bar (${usd(clay)}). Paint that looks hazy or swirled in the sun gets the one-step polish (${usd(polish)}). The order is always wash, clay, polish, then sealant. Neither is required, and we will tell you honestly if yours does not need them.` },
  { q: 'My car already has a ceramic coating. Do I need this?', a: 'No. If water still beads up tight and rolls off, the coating is doing its job, and a sealant on top adds little. A coated car mostly needs a careful hand wash. If you are not sure the coating is still there, the hose test on this page will tell you.' },
];

const schema = [
  serviceSchema({
    name: 'Paint Sealant',
    description: 'Mobile paint sealant in Oakland and the Bay Area: a ceramic sealant applied in place of the spray wax during a detail, protecting the paint for about six months.',
    path,
    image: '/images/hero-oakland-mobile-detailing.webp',
    minPrice: sealant,
    offers: [{ name: 'Ceramic sealant upgrade (6 months)', description: 'Ceramic sealant in place of the spray wax, added to a Full Detail or Exterior Only Detail.', price: String(sealant) }],
  }),
  faqSchema(faqs),
  breadcrumbSchema([{ label: 'Services', href: '/services/' }, { label: 'Paint Sealant', href: path }]),
];

const steps = [
  { title: 'Hand wash', text: 'Every sealant goes on after a careful hand wash: loose dirt, road film and the dust on the lower panels off first. No brushes.' },
  { title: 'Feel the paint', text: 'The sandwich-bag test on the hood and a lower door. Smooth as glass, we move on. Gritty, and we recommend the clay bar before anything is sealed in.' },
  { title: 'Polish, if you added it', text: 'A one-step polish smooths light swirls and haze, so the sealant protects a glossier surface. Optional, and always after the clay.' },
  { title: 'Seal and check', text: 'The ceramic sealant goes on every painted panel in place of the spray wax. Then a walk-around with you, so you can see and feel the finish.' },
];
---

<Base {title} {description} canonical={path} {schema} ogImage="/images/hero-oakland-mobile-detailing.webp" preloadImage="/images/hero-oakland-mobile-detailing.webp">
  <PageHero
    crumbs={[{ label: 'Services', href: '/services/' }, { label: 'Paint Sealant' }]}
    eyebrow="Mobile paint sealant"
    titleHtml="Paint Sealant in Oakland, <em>six months of protection instead of a few weeks</em>"
    text="A ceramic sealant in place of the spray wax that comes with every detail. It bonds harder, lasts about six months, and lets sap, salt film and brake dust rinse off instead of sticking. Same price on every vehicle."
    image="/images/hero-oakland-mobile-detailing.webp"
    imageAlt="J&W technician hand washing an SUV in a customer's driveway in the Oakland hills, with the work van behind"
    facts={[
      { label: 'Price', value: `${usd(sealant)} add-on` },
      { label: 'Lasts', value: 'About six months' },
      { label: 'Replaces', value: 'The spray wax' },
      { label: 'Vehicle size', value: 'Same price on all' },
    ]}
  />

  <section class="section">
    <div class="container prose max-prose" style="margin-inline:auto">
      <span class="eyebrow">Wax, sealant or coating</span>
      <h2>Three layers of protection, and how long each one holds</h2>
      <p>All three do the same basic job: put a thin layer between your paint and whatever lands on it. What changes is how long that layer holds up and how much work goes into it.</p>
      <ul>
        <li><strong>Spray wax.</strong> Comes with every Full Detail and Exterior Only Detail. It adds gloss and water beading, but wax is soft, and rain, washing and sun wear it off in a few weeks.</li>
        <li><strong>Ceramic sealant, {usd(sealant)}.</strong> A tougher layer that bonds better to the paint. We use it in place of the spray wax, and it lasts about six months.</li>
        <li><strong>Ceramic coating, quoted.</strong> A separate service and a much bigger job. The paint is corrected first so the coating does not lock in swirls, so we look at the car before giving a price. We do not promise a set lifespan for any coating before we have seen the paint.</li>
      </ul>
      <p>If you want your paint protected between details without a big bill, the sealant is the one. If you are keeping the car a long time or just bought something you want to keep looking right, ask about a coating. If you are selling soon or the car lives in a garage, the spray wax may be all you need. All three are part of <a href="/">car detailing that comes to you in Oakland</a>, done in your driveway with our own water and power.</p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container two-col two-col--top">
      <div class="prose">
        <span class="eyebrow">Is your car ready?</span>
        <h2>The hose test</h2>
        <p>After a wash or a rain, look at the hood and the roof. Tight, round beads that roll off when you tap the panel mean something is still protecting the paint. Water that lies flat in sheets and just sits there means the protection is gone, and the bare clear coat is taking the hits.</p>
        <p>The easiest time to add the sealant is when you are already booking a detail, because the car is washed first and the sealant goes onto clean paint. Right before the wet months is a good time. Rain kicks up oily road spray, and sealed paint lets it rinse off. So is the week after you buy a used car, when you have no idea what the last owner put on the paint, if anything.</p>
      </div>
      <div class="honest">
        <div>
          <h3>Signs it is time</h3>
          <ul class="checklist">
            <li>Water sheets flat instead of beading</li>
            <li>Water spots show up even after you towel the car dry</li>
            <li>Road film comes back fast and takes more scrubbing</li>
            <li>Sap or droppings leave a mark after a day or two</li>
            <li>You cannot remember the last wax or sealant</li>
          </ul>
        </div>
        <div>
          <h3>Fix these first</h3>
          <ul class="xlist">
            <li>Peeling or flaking clear coat: a sealant cannot stick to it</li>
            <li>Chalky, faded paint: sealing it locks in the dull look</li>
            <li>Scratches your fingernail catches: a sealant will not fill them</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Process steps={steps} heading="How the sealant goes on" eyebrow="Our process" dark />

  <section class="section">
    <div class="container prose max-prose" style="margin-inline:auto">
      <span class="eyebrow">Bay Area paint</span>
      <h2>What six months of sealant is up against here</h2>
      <p><strong>Street-tree sap.</strong> Cars parked under the trees in Rockridge, Temescal and Piedmont get a fine mist of sap through spring and summer that dries into small, hard specks. On sealed paint, most of it washes off. On bare paint, it bonds, and in the heat it can etch.</p>
      <p><strong>Brake dust.</strong> A commute on the 880 or the 580 coats the rear bumper and rocker panels in iron particles. A sealant gives them less to grab onto, so your next hand wash takes less scrubbing.</p>
      <p><strong>Salt air.</strong> Near the water in Alameda, Jack London Square and the Richmond shoreline, the marine layer leaves a salty film overnight. Sealed paint lets it rinse away rather than sit on the clear coat.</p>
      <p><strong>Inland sun.</strong> In Walnut Creek and Orinda the summer sun is stronger and the paint gets hotter. Protection wears faster there, so plan on the sealant at the start of summer as well as before the rains.</p>

      <h2>When to skip it</h2>
      <p>Matte paint and vinyl wraps need their own products; gloss products leave blotchy shiny spots, so tell us before you book. Paint fresh from a body shop needs time to cure, so ask the shop how long to wait. If you already wipe on your own spray sealant every few weeks and water still beads, you are covered. And if the car goes through a brush tunnel every week, the sealant still helps, but do not count on the full six months.</p>
    </div>
  </section>

  <Reviews limit={3} filterService="Ceramic Coating" heading="What our customers say" />
  <Faq faqs={faqs} heading="Paint sealant questions" />
  <QuoteSection eyebrow="Sealant quote" title="Tell us the car and where it parks." text="We confirm the detail, the sealant and a time, usually within minutes during business hours." />
  <CtaBand title="Protection that outlasts the wax, at the same visit." />
</Base>

<style>
  .honest { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  .honest > div { border: 1px solid var(--line); border-radius: 20px; padding: 1.4rem; }
  .honest h3 { font-size: 1.1rem; margin-bottom: 0.9rem; }
</style>
