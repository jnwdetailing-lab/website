---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PriceExplorer from '../components/PriceExplorer.astro';
import AddonsList from '../components/AddonsList.astro';
import MembershipPlans from '../components/MembershipPlans.astro';
import Faq from '../components/Faq.astro';
import QuoteSection from '../components/QuoteSection.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, CTA } from '../data/site';
import { DETAIL, EXTERIOR_ONLY, EXTRA_TIME, CERAMIC, SIZES, OVERSIZED, MEMBERSHIP, MONTHLY_FROM, planRow, from, usd } from '../data/pricing';
import { breadcrumbSchema, faqSchema } from '../data/schema';

const path = '/pricing/';
const title = 'Car Detailing Prices Oakland, CA | Full Detail & Plans | J&W';
const description = `Mobile detailing prices in Oakland and the Bay Area. Full Detail ${usd(from(DETAIL.insideOut))}–${usd(Math.max(...DETAIL.insideOut))}, interior only from ${usd(from(DETAIL.interiorOnly))}, exterior only ${usd(from(EXTERIOR_ONLY.prices))}. Monthly plans from ${usd(MONTHLY_FROM)} a visit.`;

const faqs = [
  { q: 'Which vehicle size am I?', a: `${SIZES.map((s) => `${s.label}: ${s.examples.toLowerCase()}`).join('. ')}. ${OVERSIZED.label} (${OVERSIZED.examples.toLowerCase()}) is quoted. Between two sizes, pick the bigger one, or text us the make and model and we will tell you.` },
  { q: 'Why do prices go up with vehicle size?', a: 'Time. A 7-seat SUV has roughly twice the carpet, seat fabric and paint of a sedan, and the price follows the hours it takes to do it properly.' },
  { q: 'Can the price change once you see the car?', a: `Only for things the Full Detail does not cover, and never without asking. Pet hair, stains that need shampoo, smells or bodily fluids need the matching add-on, and heavy dirt or buildup is ${usd(EXTRA_TIME.price)} per extra ${EXTRA_TIME.per}. If we see that when we arrive, we show you before we start, and you decide. We do not treat mold.` },
  { q: 'Interior + Exterior or interior only?', a: `Interior + Exterior is the full job. Interior only is the same interior work for $50 less, for when the outside is fine or you wash it yourself. Just need the outside? The ${EXTERIOR_ONLY.name} is ${usd(from(EXTERIOR_ONLY.prices))} on any size. It is our minimum service call, so promo codes and plan pricing do not apply to it.` },
  { q: 'Is there a travel fee?', a: 'Not inside our regular service area: Oakland, Alameda, Berkeley, Emeryville, Piedmont, San Leandro, Orinda, Walnut Creek and Richmond. Further out, ask us and we will tell you up front.' },
  { q: 'How do I pay?', a: 'Card, cash, Zelle or Venmo.' },
  { q: 'Do you have a membership price?', a: `Yes. Put the Full Detail on a monthly, bi-monthly or quarterly plan and every visit costs less, starting with the first. A monthly Full Detail is ${planRow(DETAIL.insideOut, MEMBERSHIP.cadences[0].save).map(usd).join(' / ')} (coupe or sedan / 5-seat SUV or truck / 7-seat SUV or minivan). Every plan price is in the table above. Complete ${MEMBERSHIP.minimumVisits} visits to keep the plan price.` },
];

const schema = [
  faqSchema(faqs),
  breadcrumbSchema([{ label: 'Pricing', href: path }]),
  {
    '@context': 'https://schema.org',
    '@type': 'OfferCatalog',
    name: 'J&W Mobile Detailing packages',
    url: `${SITE.url}${path}`,
    itemListElement: [
      ...[
        { name: `${DETAIL.name} (Interior + Exterior)`, row: DETAIL.insideOut },
        { name: 'Interior Only Detail', row: DETAIL.interiorOnly },
      ].map((o) => ({ '@type': 'Offer', name: o.name, priceCurrency: 'USD', price: from(o.row), priceSpecification: { '@type': 'PriceSpecification', minPrice: from(o.row), maxPrice: Math.max(...o.row), priceCurrency: 'USD' } })),
      { '@type': 'Offer', name: EXTERIOR_ONLY.name, priceCurrency: 'USD', price: from(EXTERIOR_ONLY.prices) },
    ],
  },
];
---

<Base {title} {description} canonical={path} {schema}>
  <PageHero
    crumbs={[{ label: 'Pricing' }]}
    eyebrow="Prices posted up front"
    title="Detailing prices for Oakland and the Bay Area"
    text="One Full Detail, inside and out or interior only, an exterior-only option and plans that take money off every visit. Pick your vehicle size and the prices below update. What you see here is what we charge for a vehicle in normal condition."
    facts={[
      { label: 'Full Detail', value: `from ${usd(from(DETAIL.insideOut))}` },
      { label: 'Interior only', value: `from ${usd(from(DETAIL.interiorOnly))}` },
      { label: 'Exterior only', value: usd(from(EXTERIOR_ONLY.prices)) },
      { label: 'Monthly plan', value: `from ${usd(MONTHLY_FROM)}/visit` },
    ]}
  />

  <PriceExplorer showTable heading="Pick your vehicle. See the price, and the plan price." />

  <AddonsList />

  <MembershipPlans picker={false} />

  <section class="section" id="ceramic-pricing">
    <div class="container">
      <div class="head">
        <span class="eyebrow">Ceramic coating</span>
        <h2>Ceramic coating is quoted for your vehicle</h2>
        <p class="lead">Every coating includes a full wash, iron and clay decontamination, and polishing before the coating goes on. The packages differ in how much paint correction comes first, so the price depends on your vehicle and the condition of the paint. Send us the make and model and a photo of the paint in direct sun, and we give you a set price before anything is booked.</p>
      </div>
      <div class="table-wrap">
        <table class="cer-table">
          <thead>
            <tr><th>Package</th><th>Prep before the coating</th></tr>
          </thead>
          <tbody>
            {CERAMIC.map((c) => (
              <tr>
                <td><strong>{c.name}</strong><br /><small>{c.bestFor}</small></td>
                <td>{c.prep}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="center" style="margin-top:1.5rem"><a href={CTA.href} class="btn btn--primary" data-scroll-book>Get a ceramic quote</a></p>
      <p class="center" style="margin-top:1rem"><a href="/ceramic-coating/">How ceramic coating works, and which package fits your paint →</a></p>
    </div>
  </section>

  <Faq faqs={faqs} heading="Pricing questions" />
  <QuoteSection title="Not sure what your car needs? Send us the car." text="Tell us the make, model and what is bothering you about it. We will tell you which add-ons, if any, it needs and confirm the price." />
  <CtaBand />
</Base>

<style>
  /* Two short columns: fits a phone without the global table min-width. */
  .cer-table { min-width: 0; }
</style>
