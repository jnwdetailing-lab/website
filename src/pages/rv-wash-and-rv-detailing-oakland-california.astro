---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Icon from '../components/Icons.astro';
import { SITE, CTA } from '../data/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../data/schema';

const path = '/rv-wash-and-rv-detailing-oakland-california/';
const title = 'Mobile RV Wash & Detailing Oakland, CA | J&W Mobile Detailing';
const description =
  'Mobile RV wash & detailing in Oakland & the East Bay: motorhomes, trailers, fifth wheels & campers washed, de-bugged, oxidation-treated & waxed on site.';

const faqs = [
  { q: 'How much does RV detailing cost in Oakland?', a: 'Every RV is priced individually because motorhomes, travel trailers and campers vary so much in length, surface (gelcoat, fiberglass, painted aluminum) and condition. Tell us the type, length and what it needs. Wash & wax, oxidation treatment, roof, interior. And we send a free quote before any work begins.' },
  { q: 'Do you come to the storage lot?', a: 'Yes. We service RVs wherever they are parked, your driveway, a storage facility, a marina lot or a campground across Oakland and the East Bay. As long as the facility allows mobile washing and we have room to work. We bring our own water and power.' },
  { q: 'How often should I wash and wax my RV in the Bay Area?', a: 'We recommend a wash and wax every 3–6 months. Sun exposure oxidizes gelcoat and fiberglass, and salt air plus road grime etch the finish; protecting it quarterly keeps the chalky white oxidation from setting in.' },
  { q: 'Can you remove oxidation from my RV?', a: 'Yes. Light to moderate chalky oxidation on gelcoat and fiberglass is removed with an oxidation compound and machine polishing, then sealed with wax. Heavy, long-neglected oxidation may need multiple stages. We will assess and quote honestly.' },
  { q: 'Do you clean RV roofs?', a: 'Yes. Roof cleaning (rubber, TPO or fiberglass) removes the black streaks at the source and is included or added depending on the package. We use roof-safe cleaners that will not degrade the membrane.' },
  { q: 'Do you detail RV interiors?', a: 'Yes. Vacuum, steam, shampoo, cabinetry, bathroom and kitchen surfaces, windows and odor treatment. The same process as our automotive interior detailing, scaled to the rig.' },
];

const schema = [
  serviceSchema({
    name: 'RV Wash & Detailing',
    description: 'Mobile RV wash and detailing in Oakland and the East Bay for motorhomes, travel trailers, fifth wheels and campers: hand wash, bug and grime removal, oxidation treatment, roof cleaning, wax and UV protection.',
    path,
    image: '/images/rv-wash-wax-oakland.jpg',
  }),
  faqSchema(faqs),
  breadcrumbSchema([{ label: 'Services', href: '/services/' }, { label: 'RV Wash & Detailing', href: path }]),
];

const steps = [
  { title: 'Full exterior wash', text: 'Bumper to bumper, roof line to skirt: pre-soak, hand wash of paint, gelcoat or fiberglass, wheels, tires and wheel wells.' },
  { title: 'Bug & grime removal', text: 'Front cap, mirrors and awning arms de-bugged; black streaks and road film removed from sidewalls and slide-outs.' },
  { title: 'Roof & oxidation treatment', text: 'Roof cleaned with membrane-safe chemistry; chalky oxidation compounded and polished out of gelcoat where needed.' },
  { title: 'Wax & protect', text: 'UV-protective wax or sealant on every exterior surface; tires dressed; glass and mirrors cleaned. Walk-around before you pay.' },
];
---

<Base {title} {description} canonical={path} {schema} ogImage="/images/rv-wash-wax-oakland.jpg" preloadImage="/images/rv-wash-wax-oakland.jpg">
  <PageHero
    crumbs={[{ label: 'Services', href: '/services/' }, { label: 'RV Wash & Detailing' }]}
    eyebrow="Mobile RV detailing · Oakland & East Bay"
    titleHtml="Mobile RV Wash & Detailing in Oakland, <em>washed, de-oxidized and waxed wherever it's parked</em>"
    text="Motorhomes, travel trailers, fifth wheels and campers. Full hand wash of paint, gelcoat or fiberglass, bug and black-streak removal, roof cleaning, oxidation treatment and UV wax. At your home or storage lot. We bring the water and power."
    note="By type, length & condition · free quote"
    image="/images/rv-wash-wax-oakland.jpg"
    imageAlt="J&W technician washing the roof line of a motorhome during mobile RV detailing in Oakland, CA"
    bullets={['Driveway, storage facility or marina. We come to the rig', 'Gelcoat & fiberglass oxidation removed, not just washed over', 'Roof cleaning with membrane-safe chemistry']}
  />

  <section class="section">
    <div class="container two-col">
      <div class="prose">
        <span class="eyebrow">What's included</span>
        <h2 class="mt-0">Everything a big rig needs, done by hand</h2>
        <p><strong>J&W's mobile RV wash and detail covers the whole exterior of your motorhome, trailer or camper. Wherever it sits in Oakland or the East Bay.</strong> Hand wash of paint, gelcoat or fiberglass, bug and road-grime removal, oxidation treatment, roof cleaning, wheels and tires, windows and mirrors, and wax or UV sealant. Interior detailing available.</p>
        <ul class="checklist">
          <li>Hand wash of paint, gelcoat or fiberglass. Full height, slides out</li>
          <li>Bug and road-grime removal from the front cap and mirrors</li>
          <li>Black streak removal on sidewalls</li>
          <li>Roof cleaning (rubber / TPO / fiberglass)</li>
          <li>Oxidation treatment & polishing on chalky gelcoat</li>
          <li>Wheels, tires & wheel wells cleaned and dressed</li>
          <li>Windows, mirrors and awning wiped</li>
          <li>Wax or sealant with UV protection</li>
          <li>Optional interior: vacuum, steam, shampoo, kitchen & bath</li>
        </ul>
        <p>Bay Area sun and salt air oxidize gelcoat faster than most owners expect, the chalky white haze you can rub off with a finger is the finish breaking down. We recommend a wash and wax every 3–6 months to keep it sealed.</p>
      </div>
      <div class="img-frame"><img src="/images/rv-detailing-oakland.jpg" alt="Foam wash running down the side of a motorhome during mobile RV detailing" width="1600" height="1076" loading="lazy" decoding="async" /></div>
    </div>
  </section>

  <Process steps={steps} heading="Our RV wash & wax process" eyebrow="How we do it" />

  <section class="section section--soft">
    <div class="container prose max-prose" style="margin-inline:auto">
      <span class="eyebrow">Pricing</span>
      <h2 class="mt-0">Every RV is quoted individually, here's what moves the price</h2>
      <p>Length (a 22 ft Class B vs. a 40 ft Class A), surface type, how much oxidation has set in, whether the roof needs a full clean, and whether you want the interior done. Tell us those things and we send a quote, free, before any work begins. We also coat larger vehicles: see <a href="/ceramic-coating/">ceramic coating</a> for multi-year protection on painted or gelcoat surfaces.</p>
      <div class="btn-row">
        <a href="#quote" class="btn btn--primary btn--lg"><Icon name="arrow" /> Get my RV quote</a>
        <a href={`tel:${SITE.phoneE164}`} class="btn btn--ghost"><Icon name="phone" /> {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <Reviews limit={3} heading="What East Bay customers say about J&W" />
  <Faq faqs={faqs} heading="RV detailing questions, answered" />

  <section class="section" id="quote">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Get a quote</span>
        <h2>Tell us the type, length and where it's parked.</h2>
        <p class="lead">Add a photo if you can, especially of any oxidation or the roof. And we'll send a price, usually within the hour.</p>
      </div>
      <QuoteForm heading="RV detailing quote" />
    </div>
  </section>

  <ServicesGrid exclude={path} heading="Other services we bring to your driveway" eyebrow="More from J&W" lead="" />
  <CtaBand title="Get the rig road-trip ready, without moving it." />
</Base>
