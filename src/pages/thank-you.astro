---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icons.astro';
import { SITE } from '../data/site';
---
<Base title="Thanks — we got your request | J&W Mobile Detailing" description="Your quote request was received. Jalil will reply shortly." canonical="/thank-you/" noindex>
  <section class="section">
    <div class="container center" style="max-width:640px">
      <span class="eyebrow">Request received</span>
      <h1>Thanks — Jalil will text or call you shortly.</h1>
      <p class="lead">Usually within the hour during business hours ({SITE.hours.label}). Want to lock in a time right now?</p>
      <div class="btn-row" style="justify-content:center">
        <a href={SITE.booking} class="btn btn--primary btn--lg" target="_blank" rel="noopener"><Icon name="calendar" /> Book a time online</a>
        <a href={`tel:${SITE.phoneE164}`} class="btn btn--ghost btn--lg"><Icon name="phone" /> {SITE.phoneDisplay}</a>
      </div>
      <p style="margin-top:2rem"><a href="/">← Back to home</a> · <a href="/services/">Services & pricing</a></p>
    </div>
  </section>
</Base>
