---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icons.astro';
import { SITE, ADS_LEAD_CONVERSION } from '../data/site';
---
<Base title="Thanks, we got your request | J&W Mobile Detailing" description="Your quote request was received. We will be in contact shortly." canonical="/thank-you/" noindex eagerTags>
  {ADS_LEAD_CONVERSION && (
    /*
      Google Ads conversion for a completed quote request. Paste the label into
      ADS_LEAD_CONVERSION in src/data/site.ts to switch this on.

      define:vars implies is:inline, which this needs twice over: Astro would
      otherwise bundle the script (and template expressions are not evaluated
      inside a processed <script> at all), and gtag has to stay a plain global
      call rather than module-scoped code.

      gtag() itself is defined in the <head> by Base.astro. Calls made before
      gtag.js has finished loading queue up on dataLayer, so firing from the body
      is safe and needs no readiness check. The window.gtag guard is only for the
      case where a content blocker stripped the base tag entirely.
    */
    <script define:vars={{ sendTo: ADS_LEAD_CONVERSION }}>
      if (window.gtag) gtag('event', 'conversion', { send_to: sendTo });
    </script>
  )}
  <section class="section">
    <div class="container center" style="max-width:640px">
      <span class="eyebrow">Request received</span>
      <h1 id="ty-h">Thanks, we will be in contact shortly.</h1>
      <p class="lead" id="ty-lead">Usually within the hour during business hours ({SITE.hours.label}). Want to lock in a time right now?</p>
      <div class="btn-row" style="justify-content:center">
        <a href={SITE.booking} class="btn btn--primary btn--lg" id="ty-book" rel="noopener"><Icon name="calendar" /> Book a time online</a>
        <a href={`tel:${SITE.phoneE164}`} class="btn btn--ghost btn--lg"><Icon name="phone" /> {SITE.phoneDisplay}</a>
      </div>
      <p style="margin-top:2rem"><a href="/">← Back to home</a> · <a href="/services/">Services & pricing</a></p>
    </div>
  </section>
  {/*
    Marks this visitor as a lead, so Book Online buttons stop asking for the form
    (see BOOK_GATE). If they came here from a Book Online click, forward them
    straight to the booking page they were heading for.
  */}
  <script is:inline define:vars={{ booking: SITE.booking }}>
    (function () {
      try {
        localStorage.setItem('jw-lead', String(Date.now()));
        var intent = JSON.parse(localStorage.getItem('jw-intent') || 'null');
        localStorage.removeItem('jw-intent');
        if (!intent || intent.v !== 'book' || Date.now() - intent.t > 864e5) return;
      } catch (e) { return; }
      document.getElementById('ty-h').textContent = 'Got it. Taking you to booking now…';
      document.getElementById('ty-lead').textContent = 'Pick your service and a time. If the page does not open, use the button below.';
      setTimeout(function () { location.href = booking; }, 1200);
    })();
  </script>
</Base>
