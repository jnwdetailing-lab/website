---
// Real J&W job photos only. Add new ones to the list as they are shot.
import { srcsetFor } from '../lib/srcset';
export interface Props { heading?: string; lead?: string }
const {
  heading = 'Real cars, real driveways, real results',
  lead = 'Recent jobs in Oakland and around the Bay Area.',
} = Astro.props;
const photos = [
  { src: '/images/paint-correction-polishing-poster.jpg', alt: 'J&W technician machine polishing a hull with a dual-action polisher', label: 'Machine polishing', w: 1280, h: 720, wide: true },
  { src: '/images/interior-detailing-oakland-after.webp', alt: 'Cloth seat after shampoo extraction and steam cleaning', label: 'Interior, after', w: 900, h: 900 },
  { src: '/images/jalil-owner-jw-mobile-detailing-oakland.jpg', alt: 'Detailing a steering wheel and dash during an interior detail', label: 'Interior detail', w: 1080, h: 1080 },
  { src: '/images/interior-detailing-steam-cleaning-oakland.jpg', alt: 'Steam cleaning the rear seat of an SUV', label: 'Steam cleaning', w: 1080, h: 1080 },
  { src: '/images/exterior-detailing-oakland.jpg', alt: 'Foam pre-soak on a car beside the J&W van before a hand wash', label: 'Exterior detail', w: 1080, h: 1080 },
  { src: '/images/hero-oakland-mobile-detailing.webp', alt: 'Hand wash in a customer driveway, with the J&W van parked behind', label: 'At your home', w: 1080, h: 608, wide: true },
];
const sizes = '(max-width: 700px) 100vw, 40vw';
---
<section class="panel panel--dark work">
  <div class="container">
    <div class="head">
      <span class="eyebrow">Our work</span>
      <h2>{heading}</h2>
      <p class="lead">{lead}</p>
    </div>
    <div class="work__grid">
      {photos.map((p) => (
        <figure class:list={['work__item', { 'work__item--wide': p.wide }]}>
          <img src={p.src} srcset={srcsetFor(p.src, p.w)} {sizes} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
          <figcaption>{p.label}</figcaption>
        </figure>
      ))}
    </div>
    <p class="center work__more"><a href="/gallery/" class="btn btn--ghost-light">See the gallery</a></p>
  </div>
</section>
<style>
  .work__grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 220px; gap: 0.9rem; }
  @media (max-width: 900px) { .work__grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 180px; } }
  .work__item { position: relative; margin: 0; border-radius: 18px; overflow: hidden; background: var(--ink-3); }
  .work__item--wide { grid-column: span 2; }
  .work__item img { width: 100%; height: 100%; object-fit: cover; }
  .work__item figcaption { position: absolute; left: 0.75rem; bottom: 0.75rem; background: rgba(13,15,18,0.78); color: #fff; font-size: 0.8rem; font-weight: 650; padding: 0.3rem 0.7rem; border-radius: 999px; }
  .work__more { margin: 2rem 0 0; }
</style>
