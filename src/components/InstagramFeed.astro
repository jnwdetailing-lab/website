---
/**
 * Instagram embed strip — recent work, straight from the feed.
 *
 * ── ADDING POSTS ────────────────────────────────────────────────────────────
 * Put permalinks in INSTAGRAM_POSTS in src/data/site.ts. On Instagram: open the
 * reel or post → ⋯ → Copy link. Reels work the same as photos. Paste the plain
 * permalink, e.g. 'https://www.instagram.com/reel/ABC123xyz/'.
 *
 * Only PUBLIC posts embed. A private account, a deleted post or a story will
 * render an empty card, so check the page after adding.
 *
 * Leave the list empty and this falls back to a plain follow card — never a row
 * of broken embeds.
 *
 * ── WHY THE SCRIPT LOADS LATE ───────────────────────────────────────────────
 * Instagram's embed.js is heavy and this strip sits at the bottom of the page,
 * so we hold it until the section is near the viewport. The blockquotes are
 * server-rendered and already in the DOM when the script arrives, so it has
 * everything to process — no repeat of the lazy-iframe race in GhlForm.astro.
 */
import { SITE } from '../data/site';
import Icon from './Icons.astro';

export interface Props {
  heading?: string;
  text?: string;
  posts?: string[];
}

const {
  heading = 'See the work — straight off the van',
  text = 'Real Bay Area cars, filmed on the job. No stock photos, no borrowed befores.',
  posts = [],
} = Astro.props;

const handle = SITE.social.instagram.replace(/^https?:\/\/(www\.)?instagram\.com\//, '').replace(/\/$/, '');
---

<section class="section section--soft ig" id="instagram">
  <div class="container">
    <div class="center ig__head">
      <span class="eyebrow">@{handle}</span>
      <h2>{heading}</h2>
      <p class="lead">{text}</p>
    </div>

    {posts.length > 0 ? (
      <div class="ig__grid" data-ig-grid>
        {posts.map((url) => (
          <blockquote
            class="instagram-media"
            data-instgrm-permalink={url}
            data-instgrm-version="14"
          ></blockquote>
        ))}
      </div>
    ) : (
      <div class="ig__empty">
        <Icon name="instagram" />
        <p>Recent details, coatings and paint corrections go up on Instagram first.</p>
        <a class="btn btn--primary" href={SITE.social.instagram} target="_blank" rel="noopener">
          Follow @{handle}
        </a>
      </div>
    )}

    {posts.length > 0 && (
      <p class="center ig__foot">
        <a href={SITE.social.instagram} target="_blank" rel="noopener">See more on Instagram →</a>
      </p>
    )}
  </div>
</section>

<style>
  .ig__head { margin-bottom: 2.25rem; }
  /* Instagram sets its own inline max-width/margin on each blockquote once
     processed, so the grid only has to hand it even columns to sit in. */
  .ig__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; align-items: start; }
  .ig__grid :global(.instagram-media) { min-width: 0 !important; width: 100% !important; margin: 0 auto !important; }
  @media (max-width: 900px) { .ig__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .ig__grid { grid-template-columns: 1fr; } }

  .ig__empty { max-width: 520px; margin: 0 auto; text-align: center; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.5rem, 4vw, 2.25rem); }
  .ig__empty :global(svg) { width: 32px; height: 32px; color: var(--ink); margin: 0 auto 0.75rem; }
  .ig__empty p { color: var(--muted); margin-bottom: 1.25rem; }

  .ig__foot { margin-top: 1.75rem; }
  .ig__foot a { font-weight: 700; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  // Pull in Instagram's embed script only as the strip comes into range, then
  // let it process the blockquotes already sitting in the DOM.
  const grid = document.querySelector('[data-ig-grid]');

  if (grid) {
    const load = () => {
      if (document.querySelector('script[data-ig-embed]')) return;
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.instagram.com/embed.js';
      s.setAttribute('data-ig-embed', '');
      // Already-loaded scripts don't re-scan, so nudge it for anything added later.
      s.onload = () => (window as any).instgrm?.Embeds?.process?.();
      document.body.appendChild(s);
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            load();
            io.disconnect();
          }
        },
        { rootMargin: '600px' },
      );
      io.observe(grid);
    } else {
      load();
    }
  }
</script>
