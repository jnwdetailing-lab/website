---
import { NAV, SITE, CTA, BOOK, ANNOUNCEMENT } from '../data/site';
import Icon from './Icons.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
// Every page carries a #quote section except these, which fall back to the home form.
const NO_QUOTE = ['/404', '/thank-you', '/privacy-policy', '/terms-conditions'];
const quoteHref = NO_QUOTE.some((p) => path.startsWith(p)) ? CTA.hrefHome : CTA.href;
export interface Props { /** Location pages pass their own number. */ phone?: { e164: string; display: string } }
const tel = Astro.props.phone ?? { e164: SITE.phoneE164, display: SITE.phoneDisplay };
---


{ANNOUNCEMENT.text && (
  <div class="announce">
    <div class="container announce__inner">
      <Icon name="repeat" size={16} />
      <p>{ANNOUNCEMENT.text}{' '}<a href={ANNOUNCEMENT.href}>{ANNOUNCEMENT.linkLabel} <span aria-hidden="true">→</span></a></p>
    </div>
  </div>
)}

<header class="nav" id="top">
  <div class="container nav__inner">
    <a href="/" class="nav__logo" aria-label="J&W Mobile Detailing home">
      <img src="/images/logo-nav.webp" srcset="/images/logo-nav-140w.webp 140w, /images/logo-nav.webp 300w" sizes="(max-width: 560px) 50px, 60px" alt="J&W Mobile Detailing logo" width="120" height="100" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li class:list={['nav__item', { 'has-children': item.children, active: isActive(item.href) }]}>
            <a href={item.href} aria-haspopup={item.children ? 'menu' : undefined} aria-expanded={item.children ? 'false' : undefined}>
              {item.label}
              {item.children && <Icon name="chevron" size={14} />}
            </a>
            {item.children && (
              <ul class="nav__dropdown">
                {item.children.map((c) => (
                  <li><a href={c.href}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__cta">
      <a href={`tel:${tel.e164}`} class="nav__phone">
        <Icon name="phone" size={17} />
        <span>{tel.display}</span>
      </a>
      <a href={BOOK.href} class="btn btn--ghost-light btn--sm nav__book">{BOOK.label}</a>
      <a href={quoteHref} class="btn btn--primary btn--sm" data-scroll-book>{CTA.label}</a>
      <button class="nav__burger" id="navToggle" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu">
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

</header>

<!-- Outside <header> on purpose: the header's backdrop-filter makes it the
     containing block for position:fixed children, which squeezed the menu into
     the 64px bar instead of covering the screen. -->
  <div class="mobile" id="mobileMenu" hidden>
    <div class="mobile__head">
      <img src="/images/logo-nav.webp" srcset="/images/logo-nav-140w.webp 140w, /images/logo-nav.webp 300w" sizes="80px" alt="" width="90" height="75" loading="lazy" />
      <button class="nav__burger" id="navClose" aria-label="Close menu"><Icon name="close" size={24} /></button>
    </div>
    <nav aria-label="Mobile">
      <ul class="mobile__list">
        {NAV.map((item) => (
          <li>
            {item.children ? (
              <details>
                <summary>{item.label} <Icon name="chevron" size={16} /></summary>
                <ul>
                  {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                </ul>
              </details>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile__cta">
      <a href={quoteHref} class="btn btn--primary btn--lg" data-scroll-book>{CTA.label}</a>
      <a href={BOOK.href} class="btn btn--dark btn--lg"><Icon name="calendar" /> {BOOK.label}</a>
      <a href={`tel:${tel.e164}`} class="btn btn--ghost btn--lg"><Icon name="phone" /> {tel.display}</a>
      <p class="mobile__meta">{SITE.hours.calls} · Oakland & the Bay Area</p>
    </div>
  </div>

<style>
  .announce { background: #000; color: #e5e7eb; font-size: 0.86rem; }
  .announce__inner { display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.55rem 0; text-align: center; }
  .announce__inner :global(svg) { color: #ff6b75; flex: none; }
  .announce p { margin: 0; }
  .announce a { color: #fff; font-weight: 650; white-space: nowrap; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) { .announce__inner :global(svg) { display: none; } .announce { font-size: 0.8rem; } }

  .nav { position: sticky; top: 0; z-index: 100; background: rgba(13, 15, 18, 0.97); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,0.06); }
  .nav__inner { display: flex; align-items: center; gap: 1rem; height: var(--nav-h); }
  .nav__logo img { height: 50px; width: auto; }
  .nav__links { margin-left: auto; }
  .nav__links > ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.1rem; }
  .nav__item { position: relative; margin: 0; }
  .nav__item > a {
    display: inline-flex; align-items: center; gap: 0.25rem; color: #d9dce2; font-weight: 600; font-size: 0.92rem; white-space: nowrap;
    padding: 0.55rem 0.7rem; border-radius: 999px; text-decoration: none;
  }
  .nav__item > a:hover, .nav__item.active > a { color: #fff; background: rgba(255,255,255,0.08); }
  .nav__dropdown {
    position: absolute; top: 100%; left: 0; min-width: 240px; background: #fff; border-radius: 16px; padding: 0.5rem; list-style: none;
    box-shadow: 0 24px 48px -16px rgba(0,0,0,0.4); display: none; flex-direction: column; gap: 0.1rem; margin-top: 0.4rem;
  }
  .nav__dropdown::before { content: ''; position: absolute; top: -0.5rem; left: 0; right: 0; height: 0.5rem; }
  .nav__dropdown li { margin: 0; }
  .nav__dropdown a { display: block; padding: 0.6rem 0.85rem; color: var(--ink); font-weight: 600; font-size: 0.93rem; border-radius: 10px; }
  .nav__dropdown a:hover { background: var(--bg-soft); text-decoration: none; }
  .has-children:hover .nav__dropdown, .has-children:focus-within .nav__dropdown { display: flex; }
  .nav__cta { display: flex; align-items: center; gap: 0.55rem; margin-left: 0.5rem; }
  .nav__phone { display: inline-flex; align-items: center; gap: 0.4rem; color: #fff; font-weight: 650; font-size: 0.95rem; white-space: nowrap; padding: 0.5rem 0.4rem; }
  .nav__burger { display: none; background: rgba(255,255,255,0.08); border: 0; color: #fff; cursor: pointer; padding: 0.5rem; border-radius: 999px; }

  .mobile { position: fixed; inset: 0; background: #fff; z-index: 200; overflow-y: auto; padding: 1rem 1.25rem 2rem; }
  .mobile[hidden] { display: none; }
  .mobile__head { display: flex; justify-content: space-between; align-items: center; }
  .mobile__head .nav__burger { color: var(--ink); background: var(--bg-soft); display: inline-flex; }
  .mobile__head img { height: 52px; width: auto; filter: invert(1); }
  .mobile__list { list-style: none; padding: 0; margin: 1rem 0; }
  .mobile__list > li { border-bottom: 1px solid var(--line); margin: 0; }
  .mobile__list a, .mobile__list summary { display: flex; justify-content: space-between; align-items: center; padding: 0.95rem 0; font-family: var(--font-display); font-size: 1.3rem; font-weight: 750; letter-spacing: -0.02em; color: var(--ink); cursor: pointer; list-style: none; }
  .mobile__list summary::-webkit-details-marker { display: none; }
  .mobile__list details ul { list-style: none; padding: 0 0 0.5rem 0.75rem; margin: 0; }
  .mobile__list details ul a { font-family: var(--font-body); font-size: 1.02rem; font-weight: 600; letter-spacing: 0; padding: 0.6rem 0; color: var(--body); }
  .mobile__cta { display: grid; gap: 0.65rem; margin-top: 1rem; }
  .mobile__meta { text-align: center; color: var(--muted); font-size: 0.9rem; margin: 0.25rem 0 0; }

  @media (max-width: 1240px) { .nav__book { display: none; } }
  @media (max-width: 1100px) {
    .nav__links { display: none; }
    .nav__burger { display: inline-flex; }
    .nav__cta { margin-left: auto; }
    /* Visually hidden, not display:none, so the icon-only link keeps the number as its name. */
    .nav__phone span { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    .nav__phone { background: rgba(255,255,255,0.08); border-radius: 999px; padding: 0.55rem; }
  }
  @media (max-width: 560px) {
    .nav__logo img { height: 42px; }
    .nav__cta { gap: 0.4rem; }
    .nav__cta .btn { font-size: 0.85rem; padding: 0.62rem 0.9rem; }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const close = document.getElementById('navClose');
  const menu = document.getElementById('mobileMenu');
  const open = (v: boolean) => {
    if (!menu || !toggle) return;
    menu.hidden = !v;
    toggle.setAttribute('aria-expanded', String(v));
    document.body.style.overflow = v ? 'hidden' : '';
    (v ? close : toggle)?.focus();
  };
  toggle?.addEventListener('click', () => open(true));
  close?.addEventListener('click', () => open(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => open(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') open(false); });
</script>
