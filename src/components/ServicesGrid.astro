---
import { SERVICES } from '../data/site';
export interface Props { exclude?: string; heading?: string; eyebrow?: string; lead?: string }
const { exclude, heading = 'What we do, done in your driveway', eyebrow = 'Mobile detailing services in Oakland', lead = 'Pick one or bundle them. Every vehicle is quoted individually once we know what you drive and what it needs.' } = Astro.props;
const list = SERVICES.filter((s) => s.slug !== exclude);
---
<section class="section" id="services">
  <div class="container">
    <div class="center" style="margin-bottom:2.5rem">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{heading}</h2>
      <p class="lead">{lead}</p>
    </div>
    <div class="grid grid--3">
      {list.map((s) => (
        <a href={s.slug} class="card svc" aria-label={`${s.name}, learn more`}>
          <img class="card__img" src={s.image} alt={s.alt} width="800" height="800" loading="lazy" decoding="async" />
          <div class="card__body">
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="card__link">Learn more</span>
          </div>
        </a>
      ))}
    </div>
    <p class="center" style="margin-top:2rem;color:var(--muted)">Add-ons: headlight restoration · engine bay · trim restoration · pet hair · windows & rims coating. <a href="/services/">See all services →</a></p>
  </div>
</section>
<style>
  .svc { color: inherit; text-decoration: none !important; }
  .svc h3 { color: var(--ink); }
</style>
