---
// Shared skeleton for city pages. All copy is passed in per city; there is no
// city-swap templating of the text itself. FAQ answers may use the price tokens
// {FULL_RANGE} {INT_RANGE} {EXT_FROM} {MEMBER_FROM}, filled from pricing.ts so
// a price change reaches every city page.
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import ServicesGrid from './ServicesGrid.astro';
import PriceExplorer from './PriceExplorer.astro';
import ComeToYou from './ComeToYou.astro';
import Faq from './Faq.astro';
import Reviews from './Reviews.astro';
import CtaBand from './CtaBand.astro';
import QuoteSection from './QuoteSection.astro';
import Icon from './Icons.astro';
import { SITE, type FAQ, CTA, BOOK } from '../data/site';
import { DETAIL, EXTERIOR_ONLY, MONTHLY_FROM, from, usd, range } from '../data/pricing';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../data/schema';

export interface Props {
  city: string;
  path: string;
  title: string;
  description: string;
  heroTitleHtml: string;
  heroText: string;
  heroImage: string;
  heroAlt: string;
  intro: string[]; // paragraphs (HTML allowed)
  neighborhoods: string[];
  localSections: { heading: string; body: string[] }[]; // HTML paragraphs
  faqs: FAQ[];
  mapEmbed: string;
  /**
   * Set only for a city that has its OWN verified Google Business Profile
   * (its own address and phone). The page then shows that profile's name,
   * address and phone (NAP) and ships a LocalBusiness block for it, so the page
   * and the profile match. City pages without their own profile leave this unset.
   */
  location?: {
    name: string;
    phoneE164: string;
    phoneDisplay: string;
    address: { street: string; city: string; region: string; zip: string };
  };
}
const p = Astro.props;
const loc = p.location;
const callE164 = loc ? loc.phoneE164 : SITE.phoneE164;
const callDisplay = loc ? loc.phoneDisplay : SITE.phoneDisplay;
// The page's own number everywhere (menu, hero, quote, footer, call bar), so it
// matches the location's Google profile instead of the main or pool number.
const tel = loc ? { e164: loc.phoneE164, display: loc.phoneDisplay } : undefined;

const tokens: Record<string, string> = {
  '{FULL_RANGE}': range(DETAIL.insideOut),
  '{INT_RANGE}': range(DETAIL.interiorOnly),
  '{EXT_FROM}': usd(from(EXTERIOR_ONLY.prices)),
  '{MEMBER_FROM}': usd(MONTHLY_FROM),
};
const fill = (t: string) => Object.entries(tokens).reduce((s, [k, v]) => s.split(k).join(v), t);
const faqs = p.faqs.map((f) => ({ q: f.q, a: fill(f.a) }));

const schema = [
  serviceSchema({
    name: `Mobile Car Detailing in ${p.city}`,
    description: p.description,
    path: p.path,
    image: p.heroImage,
    areaServed: [p.city],
    minPrice: from(EXTERIOR_ONLY.prices),
    maxPrice: Math.max(...DETAIL.insideOut),
  }),
  faqSchema(faqs),
  breadcrumbSchema([{ label: 'Service Areas', href: '/service-areas/' }, { label: p.city, href: p.path }]),
  ...(loc
    ? [
        {
          '@context': 'https://schema.org',
          '@type': ['AutoDetailing', 'LocalBusiness'],
          '@id': `${SITE.url}${p.path}#business`,
          name: loc.name,
          url: `${SITE.url}${p.path}`,
          telephone: loc.phoneE164,
          address: {
            '@type': 'PostalAddress',
            streetAddress: loc.address.street,
            addressLocality: loc.address.city,
            addressRegion: loc.address.region,
            postalCode: loc.address.zip,
            addressCountry: 'US',
          },
          logo: `${SITE.url}/images/logo.webp`,
          image: `${SITE.url}${p.heroImage}`,
          priceRange: '$$',
          areaServed: { '@type': 'City', name: p.city },
          parentOrganization: { '@id': `${SITE.url}/#business` },
        },
      ]
    : []),
];
---

<Base title={p.title} description={p.description} canonical={p.path} {schema} ogImage={p.heroImage} preloadImage={p.heroImage} phone={tel}>
  <PageHero
    phone={tel}
    crumbs={[{ label: 'Service Areas', href: '/service-areas/' }, { label: p.city }]}
    eyebrow={`Mobile detailing · ${p.city}, CA`}
    titleHtml={p.heroTitleHtml}
    text={p.heroText}
    image={p.heroImage}
    imageAlt={p.heroAlt}
    facts={[
      { label: 'Full Detail', value: `from ${usd(from(DETAIL.insideOut))}` },
      { label: 'Interior only', value: `from ${usd(from(DETAIL.interiorOnly))}` },
      { label: 'Monthly plan', value: `from ${usd(MONTHLY_FROM)}/visit` },
      { label: 'Travel fee', value: 'None' },
    ]}
  />

  <section class="section">
    <div class="container two-col two-col--top">
      <div class="prose">
        <span class="eyebrow">Detailing in {p.city}</span>
        <h2>Same van, same checklist, same prices. In your {p.city} driveway.</h2>
        {p.intro.map((para) => <p set:html={para} />)}
      </div>
      <div>
        <div class="hoods">
          <h3><Icon name="pin" size={20} /> {p.city} neighborhoods we cover</h3>
          <ul>{p.neighborhoods.map((n) => <li>{n}</li>)}</ul>
          <p>…and everywhere in between. Not sure? <a href={`tel:${callE164}`}>Call {callDisplay}</a>.</p>
          {loc && (
            <p class="nap">
              <strong>{loc.name}</strong><br />
              {loc.address.street}, {loc.address.city}, {loc.address.region} {loc.address.zip}<br />
              <a href={`tel:${loc.phoneE164}`}>{loc.phoneDisplay}</a>
            </p>
          )}
        </div>
        <div class="map"><iframe title={`Map of ${p.city}, CA service area`} src={p.mapEmbed} width="600" height="400" style="border:0" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
      </div>
    </div>
  </section>

  <ComeToYou city={p.city} heading={`We come to you anywhere in ${p.city}`} />

  <PriceExplorer compact eyebrow={`${p.city} pricing`} heading={`Detailing prices in ${p.city}`} lead={`The same prices we charge in Oakland, with no travel fee to ${p.city}. Pick your vehicle to see yours.`} />

  <section class="section section--soft">
    <div class="container prose max-prose" style="margin-inline:auto">
      {p.localSections.map((s) => (
        <>
          <h2>{s.heading}</h2>
          {s.body.map((para) => <p set:html={para} />)}
        </>
      ))}
      <div class="btn-row" style="margin-top:1.5rem">
        <a href={CTA.href} class="btn btn--primary btn--lg" data-scroll-book>{CTA.label}</a>
        <a href={BOOK.href} class="btn btn--ghost btn--lg"><Icon name="calendar" /> {BOOK.label}</a>
      </div>
    </div>
  </section>

  <ServicesGrid heading={`Every service we offer in ${p.city}`} eyebrow={`Mobile detailing services in ${p.city}`} lead="Each one done at your home or office, with our own water and power." />
  <Reviews limit={3} heading="What Bay Area drivers say about J&W" />
  <Faq phone={tel} faqs={faqs} heading={`${p.city} detailing questions`} />
  <QuoteSection phone={tel} eyebrow={`Get a quote in ${p.city}`} title={`Tell us the car and your ${p.city} address.`} text={`We confirm the price and the next openings, usually within minutes during business hours (${SITE.hours.label}).`} />
  <CtaBand phone={tel} title={`A detailed car in ${p.city}, without leaving home.`} />
</Base>

<style>
  .hoods { background: var(--bg-soft); border-radius: 20px; padding: 1.5rem; margin-bottom: 1.25rem; }
  .hoods h3 { display: flex; align-items: center; gap: 0.4rem; font-size: 1.2rem; }
  .hoods h3 :global(svg) { color: var(--red); }
  .hoods ul { list-style: none; padding: 0; margin: 0 0 0.75rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .hoods li { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.88rem; font-weight: 600; color: var(--ink); margin: 0; }
  .hoods p { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .map { border-radius: 20px; overflow: hidden; aspect-ratio: 3/2; border: 1px solid var(--line); }
  .map iframe { width: 100%; height: 100%; }
</style>
