---
// Shared skeleton for city pages. All copy is passed in per city — no city-swap templating of the text itself.
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import ServicesGrid from './ServicesGrid.astro';
import Faq from './Faq.astro';
import Reviews from './Reviews.astro';
import CtaBand from './CtaBand.astro';
import QuoteForm from './QuoteForm.astro';
import Icon from './Icons.astro';
import { SITE, type FAQ, CTA } from '../data/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../data/schema';

export interface Props {
  city: string;
  path: string;
  title: string;
  description: string;
  heroTitleHtml: string;
  heroText: string;
  heroImage: string;
  heroAlt: string;
  intro: string[]; // paragraphs (HTML allowed)
  neighborhoods: string[];
  localSections: { heading: string; body: string[] }[]; // HTML paragraphs
  faqs: FAQ[];
  mapEmbed: string;
}
const p = Astro.props;
const schema = [
  serviceSchema({
    name: `Mobile Car Detailing in ${p.city}`,
    description: p.description,
    path: p.path,
    image: p.heroImage,
    areaServed: [p.city],
  }),
  faqSchema(p.faqs),
  breadcrumbSchema([{ label: 'Service Areas', href: '/service-areas/' }, { label: p.city, href: p.path }]),
];
---

<Base title={p.title} description={p.description} canonical={p.path} {schema} ogImage={p.heroImage} preloadImage={p.heroImage}>
  <PageHero
    crumbs={[{ label: 'Service Areas', href: '/service-areas/' }, { label: p.city }]}
    eyebrow={`Mobile detailing · ${p.city}, CA`}
    titleHtml={p.heroTitleHtml}
    text={p.heroText}
    image={p.heroImage}
    imageAlt={p.heroAlt}
    note="Exterior · interior · paint correction · ceramic coating"
  />

  <section class="section">
    <div class="container two-col">
      <div class="prose">
        <span class="eyebrow">Detailing in {p.city}</span>
        <h2 class="mt-0">Same van, same checklist, same owner — in your {p.city} driveway</h2>
        {p.intro.map((para) => <p set:html={para} />)}
      </div>
      <div>
        <div class="hoods">
          <h3><Icon name="pin" size={20} /> {p.city} neighborhoods we cover</h3>
          <ul>{p.neighborhoods.map((n) => <li>{n}</li>)}</ul>
          <p>…and everywhere in between. Not sure? <a href={`tel:${SITE.phoneE164}`}>Call {SITE.phoneDisplay}</a>.</p>
        </div>
        <div class="map"><iframe title={`Map of ${p.city}, CA service area`} src={p.mapEmbed} width="600" height="400" style="border:0" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
      </div>
    </div>
  </section>

  <ServicesGrid heading={`Every service we offer, done in ${p.city}`} eyebrow={`Mobile detailing services in ${p.city}`} lead="Real 2026 East Bay price ranges. Your quote depends on vehicle size and condition — and you get it before we book." />

  <section class="section section--soft">
    <div class="container prose max-prose" style="margin-inline:auto">
      {p.localSections.map((s) => (
        <>
          <h2>{s.heading}</h2>
          {s.body.map((para) => <p set:html={para} />)}
        </>
      ))}
      <div class="btn-row" style="margin-top:1.5rem">
        <a href={CTA.href} class="btn btn--primary btn--lg" data-scroll-book><Icon name="calendar" /> {CTA.label}</a>
        <a href={`tel:${SITE.phoneE164}`} class="btn btn--ghost btn--lg"><Icon name="phone" /> {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <Reviews limit={3} heading={`What East Bay drivers say about J&W`} />
  <Faq faqs={p.faqs} heading={`${p.city} detailing questions`} />

  <section class="section" id="quote">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Get a quote in {p.city}</span>
        <h2>Tell us the vehicle and your {p.city} address, and we will send you a price.</h2>
        <p class="lead">Quotes usually go out within the hour during business hours ({SITE.hours.label}). Or book a slot straight into the calendar.</p>
        <a href={CTA.href} class="btn btn--primary btn--lg" data-scroll-book><Icon name="calendar" /> {CTA.label}</a>
      </div>
      <QuoteForm heading={`${p.city} detailing quote`} />
    </div>
  </section>

  <CtaBand title={`Ready for a showroom finish in ${p.city} — without leaving home?`} />
</Base>

<style>
  .hoods { background: var(--bg-soft); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; margin-bottom: 1.25rem; }
  .hoods h3 { display: flex; align-items: center; gap: 0.4rem; font-size: 1.3rem; }
  .hoods h3 svg { color: var(--red); }
  .hoods ul { list-style: none; padding: 0; margin: 0 0 0.75rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .hoods li { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.9rem; font-weight: 600; color: var(--ink); }
  .hoods p { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .map { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); aspect-ratio: 3/2; }
  .map iframe { width: 100%; height: 100%; }
</style>
