---
export interface Props { items: { label: string; href?: string }[]; light?: boolean }
const { items, light = false } = Astro.props;
---
<nav class:list={['crumbs', { 'crumbs--light': light }]} aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((it) => (
      <li>{it.href ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: 0.35rem; font-size: 0.85rem; color: var(--muted); }
  .crumbs li + li::before { content: '/'; margin-right: 0.35rem; opacity: 0.5; }
  .crumbs a { color: inherit; font-weight: 600; }
  .crumbs--light { color: rgba(255,255,255,0.75); }
  .crumbs--light ol { color: rgba(255,255,255,0.75); }
</style>
