---
import { SITE, CTA } from '../data/site';
import Icon from './Icons.astro';
const path = Astro.url.pathname;
const NO_QUOTE = ['/404', '/thank-you', '/privacy-policy', '/terms-conditions'];
const quoteHref = NO_QUOTE.some((p) => path.startsWith(p)) ? CTA.hrefHome : CTA.href;
export interface Props { /** Location pages pass their own number. */ phone?: { e164: string; display: string } }
const tel = Astro.props.phone ?? { e164: SITE.phoneE164, display: SITE.phoneDisplay };
---

<!-- Mobile-only action bar: call / text / quote. Hides while the quote form is in view. -->
<div class="sticky-cta" id="stickyCta" role="region" aria-label="Quick actions">
  <a href={`tel:${tel.e164}`}><Icon name="phone" size={19} /><span>Call</span></a>
  <a href={`sms:${tel.e164}`}><Icon name="message" size={19} /><span>Text</span></a>
  <a href={quoteHref} class="go" data-scroll-book><span>{CTA.label}</span></a>
</div>
<style>
  .sticky-cta { display: none; }
  @media (max-width: 820px) {
    :global(body) { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
    .sticky-cta {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 90; display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 0.4rem;
      background: rgba(13,15,18,0.97); backdrop-filter: blur(8px); border-top: 1px solid rgba(255,255,255,0.08);
      padding: 0.5rem 0.6rem calc(0.5rem + env(safe-area-inset-bottom)); transition: transform 0.25s ease;
    }
    .sticky-cta.is-hidden { transform: translateY(110%); }
    .sticky-cta a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.15rem; color: #fff; font-size: 0.72rem; font-weight: 650; padding: 0.35rem 0.25rem; border-radius: 999px; text-decoration: none; min-height: 50px; }
    .sticky-cta a.go { background: var(--red); font-size: 1rem; font-weight: 700; }
  }
</style>
<script>
  const bar = document.getElementById('stickyCta');
  const target = document.getElementById('book') || document.getElementById('quote');
  if (bar && target && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => bar.classList.toggle('is-hidden', e.intersectionRatio >= 0.3), { threshold: [0, 0.3, 1] }).observe(target);
  }
</script>
