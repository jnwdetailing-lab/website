---
import { SITE } from '../data/site';
import Icon from './Icons.astro';
const isHome = Astro.url.pathname === '/';
const bookHref = isHome ? '#book' : SITE.booking;
---
<!-- Mobile-only sticky action bar: call / text / book. Hides while the booking card is in view. -->
<div class="sticky-cta" id="stickyCta" role="region" aria-label="Quick actions">
  <a href={`tel:${SITE.phoneE164}`}><Icon name="phone" size={20} /><span>Call</span></a>
  <a href={`sms:${SITE.phoneE164}`}><Icon name="message" size={20} /><span>Text</span></a>
  <a href={bookHref} class="book" data-scroll-book rel={isHome ? undefined : 'noopener'}><Icon name="calendar" size={20} /><span>Get Price & Book</span></a>
</div>
<style>
  .sticky-cta { display: none; }
  @media (max-width: 820px) {
    :global(body) { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
    .sticky-cta {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 90; display: grid; grid-template-columns: 1fr 1fr 1.6fr;
      background: rgba(15,17,21,0.97); backdrop-filter: blur(8px); border-top: 1px solid rgba(255,255,255,0.08);
      padding: 0.45rem 0.5rem calc(0.45rem + env(safe-area-inset-bottom)); gap: 0.4rem;
      transition: transform 0.25s ease;
    }
    .sticky-cta.is-hidden { transform: translateY(110%); }
    .sticky-cta a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.15rem; color: #fff; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.4rem 0.25rem; border-radius: 10px; text-decoration: none; min-height: 48px; }
    .sticky-cta a.book { background: var(--red); flex-direction: row; gap: 0.5rem; font-family: var(--font-display); font-size: 1.02rem; }
  }
</style>
<script>
  const bar = document.getElementById('stickyCta');
  const book = document.getElementById('book');
  if (bar && book && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => bar.classList.toggle('is-hidden', e.intersectionRatio >= 0.4), { threshold: [0, 0.4, 1] }).observe(book);
  }
</script>
