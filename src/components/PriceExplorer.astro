---
// The Full Detail with live prices by vehicle size, plan prices underneath,
// and the exterior-only option. Used on the home page, the pricing page and
// the service pages. All numbers come from src/data/pricing.ts.
import { SITE, CTA, BOOK } from '../data/site';
import { DETAIL, EXTERIOR_ONLY, MEMBERSHIP, OVERSIZED, SIZES, planRow, usd, type PriceRow } from '../data/pricing';
import SizePicker from './SizePicker.astro';
import Icon from './Icons.astro';
export interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  /** Show the full per-size price grid under the card (pricing page). */
  showTable?: boolean;
  /** Hide the "what's included" lists (compact use on service pages). */
  compact?: boolean;
  id?: string;
  /** Which option the card opens on: inside and out, or interior only. */
  defaultMode?: 'io' | 'int';
}
const {
  eyebrow = 'Pricing',
  heading = 'One detail. Pick your vehicle, see your price.',
  lead = `Book it inside and out, or interior only for $50 less. Put it on a plan and every visit costs up to ${usd(MEMBERSHIP.maxSave)} less. Add-ons cover pet hair, stains and smells.`,
  showTable = false,
  compact = false,
  id = 'packages',
  defaultMode = 'io',
} = Astro.props;
const csv = (r: PriceRow) => r.join(',');
const start = (io: PriceRow, int: PriceRow) => usd(defaultMode === 'int' ? int[0] : io[0]);
---
<section class="section" id={id}>
  <div class="container">
    <div class="head">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{heading}</h2>
      <p class="lead">{lead}</p>
    </div>

    <SizePicker />

    <article class:list={['pkg', { 'pkg--compact': compact }]} data-mode={defaultMode}>
      <div class="pkg__main">
        <h3 class="pkg__name">{DETAIL.name}</h3>
        <p class="pkg__tag">{DETAIL.tagline}</p>

        <div class="pkg__modes" role="group" aria-label={`${DETAIL.name} options`}>
          <button type="button" data-mode-btn="io" aria-pressed={defaultMode === 'io' ? 'true' : 'false'}>Interior + Exterior</button>
          <button type="button" data-mode-btn="int" aria-pressed={defaultMode === 'int' ? 'true' : 'false'}>Interior only</button>
        </div>

        <div class="pkg__price">
          <span class="pkg__amount" data-prices={csv(DETAIL.insideOut)} data-prices-int={csv(DETAIL.interiorOnly)}>{start(DETAIL.insideOut, DETAIL.interiorOnly)}</span>
          <span class="pkg__per">one time, <span data-size-label>{SIZES[0].label}</span></span>
        </div>
        <p class="pkg__meta"><Icon name="clock" size={16} /> <span class="io-only">{DETAIL.hoursInsideOut}</span><span class="int-only">{DETAIL.hoursInterior}</span> at your place</p>

        <div class="pkg__plans">
          <p class="pkg__plans-h"><Icon name="repeat" size={16} /> Or put it on a plan and pay less every visit</p>
          <ul>
            {MEMBERSHIP.cadences.map((c) => {
              const io = planRow(DETAIL.insideOut, c.save);
              const int = planRow(DETAIL.interiorOnly, c.save);
              return (
                <li>
                  <span class="pkg__plan-name">{c.label}</span>
                  <span class="pkg__plan-price"><span data-prices={csv(io)} data-prices-int={csv(int)}>{start(io, int)}</span><small>/visit</small></span>
                  <span class="pkg__save">Save {usd(c.save)}</span>
                </li>
              );
            })}
          </ul>
          <a href="/membership/" class="pkg__plans-link">How plans work <span aria-hidden="true">→</span></a>
        </div>

        <div class="pkg__cta">
          <a href={CTA.href} class="btn btn--primary btn--block" data-scroll-book>{CTA.label}</a>
          <a href={BOOK.href} class="btn btn--ghost btn--block"><Icon name="calendar" /> {BOOK.label}</a>
        </div>
      </div>

      {!compact && (
        <div class="pkg__lists">
          <div>
            <h4>Interior</h4>
            <ul class="checklist">{DETAIL.interior.map((i) => <li>{i}</li>)}</ul>
          </div>
          <div class="pkg__ext">
            <h4>Exterior <span class="int-only">(not in interior only)</span></h4>
            <ul class="checklist">{DETAIL.exterior.map((i) => <li>{i}</li>)}</ul>
          </div>
        </div>
      )}
    </article>

    <div class="pkg-extra">
      <div class="pkg-extra__item">
        <div>
          <h3>Just the outside? {EXTERIOR_ONLY.name}</h3>
          <p>{EXTERIOR_ONLY.items.join(' · ')}. {EXTERIOR_ONLY.hours}.</p>
        </div>
        <p class="pkg-extra__price"><span data-prices={csv(EXTERIOR_ONLY.prices)}>{usd(EXTERIOR_ONLY.prices[0])}</span></p>
      </div>
      <a class="pkg-extra__item pkg-extra__dark" href={OVERSIZED.href}>
        <div>
          <h3>{OVERSIZED.label}</h3>
          <p>{OVERSIZED.examples}. Priced by quote: send a photo and we will reply with a number.</p>
        </div>
        <span class="pkg-extra__go">Get a quote <span aria-hidden="true">→</span></span>
      </a>
    </div>

    {showTable && (
      <details class="ptable" open>
        <summary>Every price, every vehicle size</summary>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Service</th>{SIZES.map((s) => <th>{s.label}</th>)}</tr>
            </thead>
            <tbody>
              {[
                { name: `${DETAIL.name}`, sub: 'Interior + Exterior', row: DETAIL.insideOut },
                { name: 'Interior Only Detail', sub: 'Interior only', row: DETAIL.interiorOnly },
              ].map((g) => (
                <>
                  <tr class="ptable__lead"><td><strong>{g.name}</strong><br /><small>{g.sub}, one time</small></td>{g.row.map((v) => <td class="price">{usd(v)}</td>)}</tr>
                  {MEMBERSHIP.cadences.map((c) => (
                    <tr><td>{c.label} plan<br /><small>Save {usd(c.save)} a visit</small></td>{planRow(g.row, c.save).map((v) => <td class="price">{usd(v)}</td>)}</tr>
                  ))}
                </>
              ))}
              <tr class="ptable__lead"><td><strong>{EXTERIOR_ONLY.name}</strong><br /><small>Exterior only, one time</small></td>{EXTERIOR_ONLY.prices.map((v) => <td class="price">{usd(v)}</td>)}</tr>
            </tbody>
          </table>
        </div>
        <p class="ptable__note">Prices are for a car in normal condition. Pet hair, stains, smells and biohazards are priced as add-ons below, and we confirm the total before we start. {OVERSIZED.label} vehicles are quoted. Questions? Call or text <a href={`tel:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a>.</p>
      </details>
    )}
  </div>
</section>

<style>
  .pkg { background: #fff; border: 2px solid var(--ink); box-shadow: var(--shadow); border-radius: 24px; max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 1.05fr 1fr; overflow: hidden; }
  .pkg--compact { grid-template-columns: 1fr; max-width: 560px; }
  @media (max-width: 860px) { .pkg { grid-template-columns: 1fr; } }
  .pkg__main { padding: clamp(1.4rem, 3vw, 2.1rem); display: flex; flex-direction: column; gap: 1rem; }
  .pkg__name { font-size: clamp(1.6rem, 2.8vw, 2rem); margin: 0 0 -0.6rem; }
  .pkg__tag { margin: 0; color: var(--muted); }
  .pkg__modes { display: inline-grid; grid-template-columns: 1fr 1fr; background: var(--bg-soft); border-radius: 999px; padding: 4px; gap: 4px; align-self: flex-start; }
  .pkg__modes button { font: inherit; font-size: 0.88rem; font-weight: 650; border: 0; border-radius: 999px; padding: 0.5rem 0.95rem; background: transparent; color: var(--muted); cursor: pointer; white-space: nowrap; }
  .pkg__modes button[aria-pressed='true'] { background: #fff; color: var(--ink); box-shadow: var(--shadow-sm); }
  .pkg__price { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .pkg__amount { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.8rem, 6vw, 3.5rem); letter-spacing: -0.04em; color: var(--ink); line-height: 1; }
  .pkg__per { color: var(--muted); font-size: 0.95rem; }
  .pkg__meta { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; margin: -0.3rem 0 0; font-size: 0.92rem; color: var(--muted); }
  .pkg__meta :global(svg) { color: var(--ink); }
  .pkg[data-mode='int'] .io-only, .pkg:not([data-mode='int']) .int-only { display: none; }

  .pkg__plans { background: var(--bg-soft); border-radius: 18px; padding: 1rem 1.1rem 0.9rem; }
  .pkg__plans-h { display: flex; align-items: center; gap: 0.4rem; margin: 0 0 0.6rem; font-weight: 700; color: var(--ink); font-size: 0.95rem; }
  .pkg__plans-h :global(svg) { color: var(--red); flex: none; }
  .pkg__plans ul { list-style: none; padding: 0; margin: 0; }
  .pkg__plans li { display: grid; grid-template-columns: 1fr auto auto; align-items: baseline; gap: 0.75rem; padding: 0.5rem 0; border-top: 1px solid var(--line); margin: 0; }
  .pkg__plans li:first-child { border-top: 0; }
  .pkg__plan-name { font-weight: 650; color: var(--ink); }
  .pkg__plan-price { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; color: var(--ink); white-space: nowrap; }
  .pkg__plan-price small { font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; color: var(--muted); margin-left: 0.15rem; }
  .pkg__save { background: #e3f4ea; color: #146b39; font-size: 0.78rem; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 999px; white-space: nowrap; }
  .pkg__plans-link { display: inline-block; margin-top: 0.4rem; font-weight: 700; font-size: 0.9rem; }
  .pkg__cta { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 0.55rem; }
  @media (max-width: 480px) { .pkg__cta { grid-template-columns: 1fr; } }

  .pkg__lists { background: var(--bg-soft); border-left: 1px solid var(--line); padding: clamp(1.4rem, 3vw, 2.1rem); display: grid; align-content: start; gap: 0.5rem; }
  @media (max-width: 860px) { .pkg__lists { border-left: 0; border-top: 1px solid var(--line); } }
  .pkg__lists h4 { font-family: var(--font-body); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 0.25rem 0 0.6rem; }
  .pkg__lists h4 span { text-transform: none; letter-spacing: 0; font-weight: 600; }
  .pkg__lists .checklist { font-size: 0.95rem; }
  .pkg[data-mode='int'] .pkg__ext .checklist { opacity: 0.35; text-decoration: line-through; }

  .pkg-extra { max-width: 1000px; margin: 1.25rem auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  @media (max-width: 820px) { .pkg-extra { grid-template-columns: 1fr; } }
  .pkg-extra__item { display: flex; justify-content: space-between; gap: 1rem; align-items: center; border: 1px solid var(--line); border-radius: 18px; padding: 1.2rem 1.4rem; background: var(--bg-soft); }
  .pkg-extra__item h3 { font-size: 1.08rem; margin: 0 0 0.3rem; }
  .pkg-extra__item p { margin: 0; font-size: 0.92rem; color: var(--muted); }
  .pkg-extra__price { font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; color: var(--ink) !important; white-space: nowrap; }
  a.pkg-extra__dark { background: var(--ink); border-color: var(--ink); color: #fff; text-decoration: none !important; }
  .pkg-extra__dark h3 { color: #fff; }
  .pkg-extra__dark p { color: #b6bcc6; }
  .pkg-extra__go { font-weight: 700; white-space: nowrap; color: #fff; }

  .ptable { max-width: 1000px; margin: 2rem auto 0; }
  .ptable summary { cursor: pointer; font-weight: 700; color: var(--ink); margin-bottom: 1rem; }
  .ptable td small { color: var(--muted); }
  .ptable__lead td { border-top: 2px solid var(--line); }
  .ptable__note { font-size: 0.9rem; color: var(--muted); margin-top: 0.9rem; }
</style>
