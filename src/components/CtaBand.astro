---
import { SITE, CTA, BOOK } from '../data/site';
import Icon from './Icons.astro';
export interface Props { title?: string; text?: string; variant?: 'red' | 'dark'; href?: string; label?: string; phone?: { e164: string; display: string } }
const {
  title = 'Ready when you are. We bring everything.',
  text = 'Tell us what you drive and where it parks. We will confirm your price and a time, usually the same day.',
  variant = 'dark',
  href = CTA.href,
  label = CTA.label,
  phone,
} = Astro.props;
const tel = phone ?? { e164: SITE.phoneE164, display: SITE.phoneDisplay };
const internal = href.startsWith('#') || href.startsWith('/');
---
<section class="cta-wrap">
  <div class:list={['cta-band', `cta-band--${variant}`]}>
    <div class="container cta-band__inner">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta-band__actions">
        <a href={href} class="btn btn--primary btn--lg" data-scroll-book={internal ? true : undefined}>{label}</a>
        <a href={BOOK.href} class="btn btn--ghost-light btn--lg"><Icon name="calendar" /> {BOOK.label}</a>
        <p class="cta-band__alt">or call / text <a href={`tel:${tel.e164}`}>{tel.display}</a></p>
      </div>
    </div>
  </div>
</section>
<style>
  .cta-wrap { padding: clamp(2rem, 5vw, 3.5rem) clamp(0.5rem, 1.5vw, 1rem); }
  .cta-band { max-width: 1320px; margin-inline: auto; border-radius: var(--radius-lg); padding: clamp(2.5rem, 6vw, 4rem) 0; color: #fff; }
  .cta-band--dark { background: radial-gradient(700px 300px at 10% 120%, rgba(225,29,42,0.3), transparent 60%), var(--ink); }
  .cta-band--red { background: linear-gradient(120deg, var(--red-dark), var(--red)); }
  .cta-band__inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: center; }
  .cta-band h2 { color: #fff; margin-bottom: 0.5rem; }
  .cta-band p { margin: 0; color: rgba(255,255,255,0.8); font-size: 1.05rem; max-width: 52ch; }
  .cta-band__actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.6rem; align-items: center; }
  .cta-band__alt { width: 100%; text-align: right; font-size: 0.92rem; }
  .cta-band__alt a { color: #fff; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) {
    .cta-band__inner { grid-template-columns: 1fr; }
    .cta-band__actions { justify-content: flex-start; }
    .cta-band__actions .btn { width: 100%; }
    .cta-band__alt { text-align: left; }
  }
</style>
