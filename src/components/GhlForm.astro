---
/**
 * GoHighLevel (LeadConnector) form embed.
 *
 * Active form: "8/26 Website Form"  ·  id GwLyoWy5IUhL15W1VIVq
 *
 * ── REPLACING THE FORM LATER ────────────────────────────────────────────────
 * In GHL: Sites → Forms → Builder → open the form → Integrate → Inline → Copy Code.
 * Paste the <iframe> between GHL:START and GHL:END below, then keep three local edits:
 *   1. rename its  src=  attribute to  data-src={formSrc}  (the loader script at
 *      the bottom of this file sets the real src once the page has loaded)
 *   2. leave out GHL's <script src=".../form_embed.js"> tag, the loader adds it
 *   3. do NOT add loading="lazy" to the iframe — see the note at GHL:START
 * Set FORM_PROVIDER back to 'native' in src/data/site.ts to fall back to the
 * built-in form at any time.
 *
 * ── PER-PAGE SERVICE PREFILL (optional) ─────────────────────────────────────
 * To have the Service field arrive pre-selected on each service page:
 *   1. In the GHL form builder, open the Service field → set its Query Key
 *      (e.g. "service").
 *   2. Put that same key in SERVICE_QUERY_KEY below.
 *   3. Make sure the values in SERVICE_BY_PATH exactly match your dropdown
 *      options in GHL, or the prefill silently won't match.
 * Leave it as '' to disable — the form works fine either way.
 * ────────────────────────────────────────────────────────────────────────────
 */
import { SITE } from '../data/site';
import Icon from './Icons.astro';

export interface Props { heading?: string; bare?: boolean; compact?: boolean }
const { heading = 'Request a quote', bare = false } = Astro.props;

const FORM_ID = 'GwLyoWy5IUhL15W1VIVq';
const FORM_NAME = '8/26 Website Form';

// '' disables prefill. Set to the Query Key you gave the Service field in GHL.
const SERVICE_QUERY_KEY = '';

const SERVICE_BY_PATH: Record<string, string> = {
  '/ceramic-coating/': 'Ceramic Coating',
  '/paint-correction/': 'Paint Correction',
  '/interior-auto-detailing-oakland-california/': 'Interior Detailing',
  '/exterior-auto-detailing-oakland-california/': 'Exterior Detailing',
  '/odor-removal-oakland/': 'Odor Removal',
  '/rv-wash-and-rv-detailing-oakland-california/': 'RV Wash & Detailing',
};

const service = SERVICE_BY_PATH[Astro.url.pathname];
const formSrc =
  SERVICE_QUERY_KEY && service
    ? `https://api.leadconnectorhq.com/widget/form/${FORM_ID}?${SERVICE_QUERY_KEY}=${encodeURIComponent(service)}`
    : `https://api.leadconnectorhq.com/widget/form/${FORM_ID}`;
---

<div class:list={['ghl', { 'ghl--bare': bare }]}>
  {!bare && (
    <div class="ghl__head">
      <h3>{heading}</h3>
      <p>Tell us about your vehicle and we will get back to you, usually within the hour during business hours.</p>
    </div>
  )}

  <div class="ghl__embed">
    <p class="ghl__loading" aria-hidden="true">Loading the quote form…</p>
    <!-- GHL:START -->
    <!--
      No loading="lazy" here, deliberately: a lazy iframe loads on its own
      schedule, after form_embed.js has already run its init/postMessage
      handshake against the frame, so the form never gets set up and the visitor
      sees an empty box. That is why it once broke on phones and not on desktop.

      Instead the frame starts with data-src only, and the loader at the bottom of
      this file sets src and then adds form_embed.js, in that order, once the page
      has loaded (or sooner, on the first scroll or tap). The form pulls in ~3 MB
      (GoHighLevel's app plus a Cloudflare bot check); letting it load alongside
      the page made the hero image and fonts wait behind it.
    -->
    <iframe
      data-src={formSrc}
      style="width:100%;border:none;border-radius:8px"
      id={`inline-${FORM_ID}`}
      data-layout={"{'id':'INLINE'}"}
      data-trigger-type="alwaysShow"
      data-trigger-value=""
      data-activation-type="alwaysActivated"
      data-activation-value=""
      data-deactivation-type="neverDeactivate"
      data-deactivation-value=""
      data-form-name={FORM_NAME}
      data-height="undefined"
      data-layout-iframe-id={`inline-${FORM_ID}`}
      data-form-id={FORM_ID}
      data-cookie-consent="true"
      data-cookie-consent-provider="auto"
      title={FORM_NAME}
      scrolling="no"
    ></iframe>
    <!-- GHL:END -->
    <noscript><p class="ghl__noscript"><a href={formSrc} target="_blank" rel="noopener">Open the quote form →</a></p></noscript>
  </div>

  <!--
    Revealed by the script below only if the embed never renders, a phone
    content blocker, iOS Private Relay or a GHL outage all leave a blank box
    otherwise, on the one page that earns the leads.
  -->
  <div class="ghl__fallback" hidden>
    <p class="ghl__fallback-h"><Icon name="phone" /> Form not loading?</p>
    <p>Call or text and we will price your vehicle directly, no form needed.</p>
    <div class="ghl__fallback-actions">
      <a class="btn btn--primary" href={`tel:${SITE.phoneE164}`}>Call {SITE.phoneDisplay}</a>
      <a class="btn btn--ghost" href={`sms:${SITE.phoneE164}`}>Text us</a>
    </div>
    <p class="ghl__fallback-alt">
      <a href={formSrc} target="_blank" rel="noopener">Open the quote form in a new tab →</a>
    </p>
  </div>
</div>

<style>
  /* --ghl-min-h reserves space so the page doesn't jump while the iframe loads.
     It matches the height GHL gives the form once rendered (measured Oct 2026:
     1034px from desktop down to ~400px wide, 1056px at 360px), so when .is-sized
     below drops the floor the box changes by a few pixels at most. Re-measure if
     fields are added to or removed from the form in GHL. */
  .ghl { --ghl-min-h: 1040px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.25rem, 3vw, 2rem); box-shadow: var(--shadow); }
  @media (max-width: 380px) { .ghl { --ghl-min-h: 1060px; } }
  .ghl--bare { border: 0; padding: 0; box-shadow: none; background: transparent; }
  .ghl__head h3 { margin-bottom: 0.25rem; }
  .ghl__head p { color: var(--muted); font-size: 0.95rem; margin-bottom: 1.25rem; }
  .ghl__embed { position: relative; min-height: var(--ghl-min-h); }
  .ghl__loading { position: absolute; top: 1.25rem; left: 0; right: 0; margin: 0; text-align: center; font-size: 0.95rem; color: var(--muted); }
  .ghl.is-sized .ghl__loading, .ghl.is-failed .ghl__loading { display: none; }
  .ghl__noscript { margin: 0; text-align: center; }
  .ghl__embed :global(iframe) { width: 100%; min-height: var(--ghl-min-h); border: 0; border-radius: 8px; display: block; }

  /* GHL has reported a real height — let it win, so no dead space under the form. */
  .ghl.is-sized .ghl__embed,
  .ghl.is-sized .ghl__embed :global(iframe) { min-height: 0; }

  /* Embed never rendered: collapse the reserved space and show the fallback. */
  .ghl.is-failed .ghl__embed,
  .ghl.is-failed .ghl__embed :global(iframe) { min-height: 0; }
  .ghl.is-failed .ghl__embed { display: none; }

  .ghl__fallback { border: 1.5px solid var(--line); border-radius: 10px; padding: 1.25rem; background: #fff; }
  .ghl__fallback-h { font-weight: 700; color: var(--ink); margin-bottom: 0.35rem; }
  .ghl__fallback-h :global(svg) { display: inline-block; width: 1em; height: 1em; vertical-align: -2px; margin-right: 0.35rem; }
  .ghl__fallback p { font-size: 0.92rem; color: var(--muted); margin-bottom: 0.9rem; }
  .ghl__fallback-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .ghl__fallback-actions .btn { width: 100%; }
  .ghl__fallback-alt { margin: 0.9rem 0 0 !important; text-align: center; font-size: 0.82rem !important; }
  .ghl__fallback-alt a { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 400px) { .ghl__fallback-actions { grid-template-columns: 1fr; } }

</style>

<script>
  /**
   * Loader + watchdog for the third-party embed.
   *
   * Loader: sets each frame's src from data-src, then adds GHL's form_embed.js,
   * once the window has finished loading, or earlier on the visitor's first
   * scroll, tap or key press (someone heading for the form shouldn't wait).
   *
   * Watchdog: form_embed.js sets an inline height on the iframe and then makes
   * it visible once the form has actually rendered, so a height on a visible
   * frame is our proof of life. GHL sets the height while the frame is still
   * hidden off-screen; treating that as ready dropped the reserved space early
   * and made the page collapse and jump (most of the old layout-shift score).
   * If the form never shows (blocked host, dead frame, GHL outage) we swap in
   * call/text rather than leaving a blank box on the page every CTA points at.
   */
  const EMBED_JS = 'https://link.msgsndr.com/js/form_embed.js';
  const READY_TIMEOUT_MS = 8000;
  const wraps = Array.from(document.querySelectorAll<HTMLElement>('.ghl'));

  const watch = (wrap: HTMLElement, frame: HTMLIFrameElement) => {
    const fallback = wrap.querySelector<HTMLElement>('.ghl__fallback');
    if (!fallback) return;

    const ready = () => parseInt(frame.style.height, 10) > 0 && getComputedStyle(frame).visibility !== 'hidden';

    // Keep watching after the timeout: a slow phone connection can deliver the
    // form late, and it should take the page back rather than leave the visitor
    // on the fallback for the rest of the visit.
    const markReady = () => {
      wrap.classList.remove('is-failed');
      wrap.classList.add('is-sized');
      fallback.hidden = true;
      observer.disconnect();
      clearTimeout(timer);
    };

    const showFallback = () => {
      if (wrap.classList.contains('is-sized')) return;
      wrap.classList.add('is-failed');
      fallback.hidden = false;
    };

    const observer = new MutationObserver(() => { if (ready()) markReady(); });
    observer.observe(frame, { attributes: true, attributeFilter: ['style'] });

    const timer = setTimeout(showFallback, READY_TIMEOUT_MS);
    frame.addEventListener('error', showFallback);
    if (ready()) markReady();
  };

  if (wraps.length) {
    let started = false;
    const triggers = ['pointerdown', 'touchstart', 'keydown', 'scroll', 'wheel'];
    const opts = { passive: true, capture: true };

    const start = () => {
      if (started) return;
      started = true;
      triggers.forEach((t) => removeEventListener(t, start, opts));
      wraps.forEach((wrap) => {
        const frame = wrap.querySelector<HTMLIFrameElement>('iframe[data-src]');
        if (!frame) return;
        frame.src = frame.dataset.src!;
        watch(wrap, frame);
      });
      // After the frames have their src: form_embed.js initialises whatever
      // GHL iframes are in the DOM when it runs.
      const s = document.createElement('script');
      s.src = EMBED_JS;
      s.async = true;
      document.body.appendChild(s);
    };

    if (document.readyState === 'complete') start();
    else {
      addEventListener('load', start, { once: true });
      triggers.forEach((t) => addEventListener(t, start, opts));
    }
  }
</script>
