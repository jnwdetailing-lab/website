---
import { SITE, SERVICES, AREAS, CTA, BOOK } from '../data/site';
import Icon from './Icons.astro';
const year = new Date().getFullYear();
export interface Props { /** Location pages pass their own number. */ phone?: { e164: string; display: string } }
const tel = Astro.props.phone ?? { e164: SITE.phoneE164, display: SITE.phoneDisplay };
---


<footer class="footer">
  <div class="footer__panel">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <img src="/images/logo-nav.webp" srcset="/images/logo-nav-140w.webp 140w, /images/logo-nav.webp 300w" sizes="96px" alt="J&W Mobile Detailing" width="150" height="125" loading="lazy" />
          <p>Mobile car detailing and ceramic coating across Oakland and the Bay Area. We bring the water, the power and the equipment to your driveway, office or garage.</p>
          <div class="footer__rating">
            <span class="stars" aria-hidden="true">{Array.from({ length: 5 }).map(() => <Icon name="star" size={16} />)}</span>
            <a href={SITE.social.google} target="_blank" rel="noopener">{SITE.rating.value} · {SITE.rating.count} Google reviews</a>
          </div>
          <div class="btn-row footer__cta">
            <a href={CTA.hrefHome} class="btn btn--primary btn--sm">{CTA.label}</a>
            <a href={BOOK.href} class="btn btn--ghost-light btn--sm">{BOOK.label}</a>
          </div>
          <ul class="footer__social" aria-label="Social profiles">
            <li><a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={20} /></a></li>
            <li><a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={20} /></a></li>
            <li><a href={SITE.social.yelp} target="_blank" rel="noopener" aria-label="Yelp"><Icon name="yelp" size={20} /></a></li>
            <li><a href={SITE.social.nextdoor} target="_blank" rel="noopener" aria-label="Nextdoor"><Icon name="nextdoor" size={20} /></a></li>
            <li><a href={SITE.social.google} target="_blank" rel="noopener" aria-label="Google Business Profile"><Icon name="google" size={20} /></a></li>
          </ul>
        </div>

        <nav class="footer__col" aria-label="Services">
          <h2 class="footer__h">Services</h2>
          <ul>
            <li><a href="/pricing/">Pricing</a></li>
            <li><a href="/membership/">Membership plans</a></li>
            {SERVICES.map((s) => <li><a href={s.slug}>{s.name}</a></li>)}
          </ul>
        </nav>

        <nav class="footer__col" aria-label="Locations">
          <h2 class="footer__h">Locations</h2>
          <ul>
            {AREAS.map((a) => <li><a href={a.slug}>{a.city}</a></li>)}
            <li><a href="/service-areas/">All service areas</a></li>
          </ul>
        </nav>

        <nav class="footer__col" aria-label="Company">
          <h2 class="footer__h">Company</h2>
          <ul>
            <li><a href="/about-us/">About J&W</a></li>
            <li><a href="/reviews/">Reviews</a></li>
            <li><a href="/gallery/">Our work</a></li>
            <li><a href="/blog/">Blog & guides</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </nav>

        <div class="footer__col footer__contact">
          <h2 class="footer__h">Contact</h2>
          <ul>
            <li><Icon name="phone" size={18} /> <a href={`tel:${tel.e164}`}>{tel.display}</a></li>
            <li><Icon name="message" size={18} /> <a href={`sms:${tel.e164}`}>Text us</a></li>
            <li><Icon name="mail" size={18} /> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><Icon name="clock" size={18} /> <span>{SITE.hours.calls}<br /><small>Appointments {SITE.hours.label}</small></span></li>
            <li><Icon name="pin" size={18} /> <span>Based in Oakland, CA 94606<br /><small>Mobile service, we come to you</small></span></li>
          </ul>
        </div>
      </div>

      <div class="footer__bottom">
        <p>© {year} {SITE.name}. Serving the Bay Area since {SITE.founded}. Licensed and insured.</p>
        <p><a href="/privacy-policy/">Privacy policy</a> · <a href="/terms-conditions/">Terms & conditions</a></p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 0 clamp(0.5rem, 1.5vw, 1rem) clamp(0.5rem, 1.5vw, 1rem); }
  .footer__panel { background: var(--ink); color: #aeb4be; border-radius: var(--radius-lg); padding: clamp(3rem, 6vw, 4.5rem) 0 2rem; font-size: 0.95rem; max-width: 1320px; margin-inline: auto; }
  .footer a:not(.btn) { color: #e4e7ec; }
  .footer a:not(.btn):hover { color: #fff; }
  /* h2 so headings never skip a level after the page content; styled small. */
  .footer .footer__h { font-family: var(--font-body); color: #fff; letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.8rem; font-weight: 700; line-height: 1.2; margin-bottom: 1rem; }
  .footer__grid { display: grid; grid-template-columns: 1.7fr 1fr 1fr 0.9fr 1.3fr; gap: 2rem; }
  .footer__brand img { height: 76px; width: auto; margin-bottom: 1rem; }
  .footer__brand p { max-width: 40ch; }
  .footer__rating { display: flex; align-items: center; gap: 0.5rem; margin: 0.5rem 0 1rem; }
  .footer__cta { margin-bottom: 1.25rem; }
  .footer__social { list-style: none; padding: 0; margin: 0; display: flex; gap: 0.45rem; }
  .footer__social li { margin: 0; }
  .footer__social a { display: inline-flex; padding: 0.55rem; border-radius: 50%; background: rgba(255,255,255,0.07); }
  .footer__social a:hover { background: var(--red); }
  .footer__col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .footer__col li { margin: 0; }
  .footer__contact li { display: flex; gap: 0.55rem; align-items: flex-start; }
  .footer__contact :global(svg) { flex: none; margin-top: 3px; color: #ff6b75; }
  .footer__bottom { border-top: 1px solid rgba(255,255,255,0.08); margin-top: 2.5rem; padding-top: 1.25rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; font-size: 0.85rem; color: #8b919d; }
  .footer__bottom p { margin: 0; }
  .footer__bottom a { color: #aeb4be; }
  @media (max-width: 1000px) { .footer__grid { grid-template-columns: 1fr 1fr; } .footer__brand { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .footer__grid { grid-template-columns: 1fr 1fr; gap: 1.75rem 1rem; } .footer__contact { grid-column: 1 / -1; } }
</style>
