{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/paint-correction-2", "destination": "/paint-correction/", "permanent": true },
    { "source": "/paint-correction-2/", "destination": "/paint-correction/", "permanent": true },
    { "source": "/location", "destination": "/service-areas/", "permanent": true },
    { "source": "/location/", "destination": "/service-areas/", "permanent": true },
    { "source": "/cart-detailing", "destination": "/services/", "permanent": true },
    { "source": "/cart-detailing/", "destination": "/services/", "permanent": true },
    { "source": "/homepage-1/", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
    ] }
  ]
}
